function Tab:CreateSlider(opts)
    opts = opts or {}
    local name     = opts.Name or opts[1] or "Slider"
    local min      = opts.Min or opts[2] or 0
    local max      = opts.Max or opts[3] or 100
    local default  = opts.Default or opts[4] or min
    local suffix   = opts.Suffix or ""
    local callback = opts.Callback or opts[5]
    local step     = opts.Step or 1

    local value = math.clamp(default, min, max)

    local frame = create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        Parent = self.Container,
    })

    local titleLbl = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -60, 0, 16),
        Font = Theme.FontMedium,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = name,
        Parent = frame,
    })

    local valueLbl = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 60, 0, 16),
        Position = UDim2.new(1, -60, 0, 0),
        Font = Theme.FontBold,
        TextSize = 12,
        TextColor3 = Theme.Primary,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = tostring(value) .. suffix,
        Parent = frame,
    })

    local track = create("Frame", {
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, 26),
        BackgroundColor3 = Theme.Stroke,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        Parent = frame,
    })
    corner(track, UDim.new(1, 0))

    local fill = create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Primary,
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(fill, UDim.new(1, 0))

    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new((value - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(knob, UDim.new(1, 0))
    create("UIStroke", { Color = Theme.Primary, Thickness = 2, Parent = knob })

    local hit = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0, 0, 0, 17),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame,
    })

    local dragging = false

    local function updateFromInput(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local raw = min + (max - min) * rel
        local snapped = math.floor(raw / step + 0.5) * step
        value = math.clamp(snapped, min, max)
        local alpha = (value - min) / (max - min)
        tween(fill, { Size = UDim2.new(alpha, 0, 1, 0) }, Theme.TweenFast)
        tween(knob, { Position = UDim2.new(alpha, -7, 0.5, -7) }, Theme.TweenFast)
        valueLbl.Text = tostring(math.floor(value * 1000) / 1000) .. suffix
        if callback then task.spawn(callback, value) end
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return setmetatable({
        Value = value,
        Set = function(v)
            value = math.clamp(v, min, max)
            local alpha = (value - min) / (max - min)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, -7, 0.5, -7)
            valueLbl.Text = tostring(value) .. suffix
            if callback then task.spawn(callback, value) end
        end,
        Get = function() return value end,
        DestroyElement = frame,
        VisibleElement = frame,
        TitleLabel = titleLbl,
    }, Option)
end

function Tab:CreateDropdown(opts)
