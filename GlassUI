function Option:SetVisible(v)
    if self.VisibleElement then self.VisibleElement.Visible = v end
    return self
end

function Option:SetTitle(v)
    if self.TitleLabel then self.TitleLabel.Text = v end
    return self
end

function Option:SetDescription(v)
    if self.DescriptionLabel then self.DescriptionLabel.Text = v end
    return self
end

function Option:Destroy()
    if self.DestroyElement then self.DestroyElement:Destroy() end
end

