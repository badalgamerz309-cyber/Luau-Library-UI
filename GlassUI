    -- ========================================================================================
    function classTab:AddKeybind(opts)
        local title = opts[1] or opts.Name or opts.Title
        local desc  = opts.Desc or opts.Description or ""
        local default = opts[2] or opts.Default or Enum.KeyCode.Unknown
        local cb = F(opts[3] or opts.Callback)
        local flag = opts[4] or opts.Flag

        assert(type(title) == "string", "Tab.AddKeybind.Title must be string")
        assert(typeof(default) == "EnumItem", "Tab.AddKeybind.Default must be a KeyCode")

        local renderer = TabRenderers[self]
        local opt, titleLbl, descLbl = buildRow(self, title, desc, UDim2.new(1, -120, 0, 0))

        local btn = E("TextButton", opt, {
            Size = UDim2.new(0, 110, 0, 22),
            Position = UDim2.new(1, -10, 0.5),
            AnchorPoint = Vector2.new(1, 0.5),
            AutoButtonColor = false,
            Text = default.Name,
            TextSize = 11,
            ThemeTag = {
                OBJECTS = renderer,
                BackgroundColor3 = "Colors.Stroke",
                TextColor3 = "Colors.Text.Default",
                Font = "Font.Bold",
            },
            Elements = { Corner = Library.CurrentTheme.CornerRadiusButton },
        })

        local listening = false
        local currentKey = default

        local function apply(key)
            if key == nil then key = Enum.KeyCode.Unknown end
            currentKey = key
            btn.Text = key.Name
            if flag ~= nil then Flags[flag] = key end
            RunCallbacks(cb, key)
        end

        local keybind = ComponentClasses.Keybind.new(self, opt, titleLbl, descLbl, apply, cb)
        keybind:SetValue(default)

        btn.Activated:Connect(function()
            if listening then return end
            listening = true
            btn.Text = "..."
            J(btn, "BackgroundColor3", resolvePath(Library.CurrentTheme, "Colors.Primary"), 0.2):Play()
        end)

        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if not listening then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            listening = false
            J(btn, "BackgroundColor3", resolvePath(Library.CurrentTheme, "Colors.Stroke"), 0.2):Play()
            if input.KeyCode == Enum.KeyCode.Backspace then
                apply(Enum.KeyCode.Unknown)
            else
                apply(input.KeyCode)
            end
        end)

        return keybind
    end

