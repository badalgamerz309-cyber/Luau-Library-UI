local K = function(list, raw)
    local set = {}
    for i = 1, #list do
        rawset(set, list[i], true)
    end
    return set
end

local L = K(string.split"\n\t,_:;()[]#&=!. \"'*^<>$")
local M = function(str)
    return string.gsub(str:lower(), ".", function(ch)
        return L[ch] and "" or ch
    end)
end

local N = function(num)
    local str, out, count = tostring(num), "", 0
    for i = #str, 1, -1 do
        out = str:sub(i, i) .. out
        count += 1
        if i > 1 and count % 3 == 0 then
            out = "," .. out
        end
    end
    return out
end

local O = function(str)
    local prefix = "rbxassetid://"
    return str:sub(1, #prefix) == prefix
end

local P = function(scale)
    return (t.Y / 450) * scale
end

local Q = function(seconds)
    local mins = math.floor(seconds / 60)
    local hours = math.floor(seconds / 60 / 60)
    seconds = math.floor((seconds - (mins * 60)) * 10) / 10
    mins = mins - (hours * 60)
    if hours > 0 then
        return ("%dh %dm %ds"):format(hours, mins, math.floor(seconds))
    elseif mins > 0 then
        return ("%dm %ds"):format(mins, math.floor(seconds))
    else
        return tostring(seconds)
    end
end

