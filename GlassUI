            Size = UDim2.new(1, -6, 1, -6),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ScrollBarThickness = 3,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.new(),
            ScrollingDirection = Enum.ScrollingDirection.Y,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Active = true,
            ThemeTag = { ScrollBarImageColor3 = "Colors.ScrollBar", ScrollBarImageTransparency = 0.3 },
            Elements = {
                Padding = {
                    PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
                    PaddingTop  = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
                },
                ListLayout = { Padding = UDim.new(0, 3) },
            },
        })

        popupRoot.Parent = nil

        local PANEL_WIDTH, ROW_HEIGHT, MAX_ROWS = 160, 25, 12

        local function rowCountFor(n)
            local scale = UIScale.Scale
            local avail = ScreenGui.AbsoluteSize.Y / scale
            return math.min((ROW_HEIGHT * math.max(n, 0.5)) + 10, (ROW_HEIGHT * MAX_ROWS) + 10, avail / 1.75)
        end

        local function isMouseOverPanel()
            if not popupPanel.Parent then return false end
            local p0, p1 = popupPanel.AbsolutePosition, popupPanel.AbsoluteSize
            local m = Vector2.new(Mouse.X, Mouse.Y)
            return m.X >= p0.X and m.X <= (p0.X + p1.X) and m.Y >= p0.Y and m.Y <= (p0.Y + p1.Y)
        end

        local function positionPopup(count)
            local hostAbs, hostSize = box.AbsolutePosition, box.AbsoluteSize
            local mainSize = MainFrame.AbsoluteSize
            local scale = UIScale.Scale
            local popupH = rowCountFor(count)
            local mainW, mainH = mainSize.X / scale, mainSize.Y / scale
            local hostX, hostY, hostH = hostAbs.X / scale, hostAbs.Y / scale, hostSize.Y / scale
            local centerY = hostY + (hostH / 2)
            local topY = centerY - (popupH / 2)
            local margin = 5
            local maxY = mainH - popupH - margin
            local finalY = clamp(topY, margin, math.max(margin, maxY))
            local anchor = Vector2.new(0, 0)
            if finalY > (mainH * 0.7) then
                anchor = Vector2.new(0, 1)
                finalY = math.min(centerY + (popupH / 2), mainH - margin)
            end
            local finalX = clamp(hostX, margin,
                math.max(margin, mainW - popupPanel.Size.X.Offset - (margin * 2) - (popupSearch.AbsoluteSize.X / scale)))
            return Vector2.new(finalX, finalY), anchor
        end

        local function applyPopupPosition(count)
            local pos, anchor = positionPopup(count)
            popupPanel.AnchorPoint = anchor
            popupPanel.Position = UDim2.fromOffset(pos.X, pos.Y)
        end

        local searchOpen, panelOpen = false, false

        local function closeSearch()
            if not searchOpen then return end
            searchOpen = false
            popupSearchBox.Text = ""
            local tw = J(popupSearchBox, "Size", UDim2.new(0, 0, 1, 0), 0.2)
            tw:Play(); tw.Completed:Wait()
            popupSearchBox.Visible = false
        end

        local function openSearch()
            if searchOpen then return end
            searchOpen = true
            popupSearchBox.Visible = true
            J(popupSearchBox, "Size", UDim2.new(0, 100, 1, 0), 0.3):Play()
            popupSearchBox:CaptureFocus()
        end

        local function setSelected(option, value)
            option.Selected = value
            local inst = option.Instance
            if not inst then return end
            local lbl, bar = inst.TextLabel, inst.Frame
            local alpha = value and 0 or (multiSelect and 0.8 or 1)
            local textAlpha = value and 0 or 0.4
            local barSize = UDim2.fromOffset(4, value and 14 or 4)
            if inst.Parent then
                J(bar, "BackgroundTransparency", alpha, 0.35):Play()
                J(lbl, "TextTransparency", textAlpha, 0.35):Play()
                J(bar, "Size", barSize, 0.35):Play()
            else
                lbl.TextTransparency = textAlpha
                bar.BackgroundTransparency = alpha
                bar.Size = barSize
            end
        end

        local function refreshDisplay()
            local text
            if multiSelect then
                local picked = {}
                for name, on in pairs(optionEnabled) do if on then picked[#picked + 1] = name end end
                text = table.concat(picked, ", ")
            else
                text = selected and selected.Name or ""
            end
            if #text >= 100 then text = text:sub(1, 97) .. "..." end
            displayLbl.Text = #text ~= 0 and text or "..."
        end

        local pending = false
        local function scheduleDisplay()
            if pending then return end
            pending = true
            task.delay(0.05, function()
                pending = false
                local value = multiSelect and optionEnabled or (selected and selected.Name)
                RunCallbacks(cb, multiSelect and optionEnabled or value)
                refreshDisplay()
                if flag ~= nil then Flags[flag] = value end
            end)
        end

        local function toggleOption(option)
            if multiSelect then
                local newState = not option.Selected
                setSelected(option, newState)
                optionEnabled[option.Name] = newState
            else
                if selected == option then return end
                if selected then setSelected(selected, false) end
                selected = option
                setSelected(option, true)
            end
            scheduleDisplay()
        end

        local function ensureOption(name)
            name = tostring(name)
            if optionsMap[name] then return end
            local entry = { Name = name, DisplayName = name, Selected = false }
            if multiSelect and optionEnabled[name] == nil then optionEnabled[name] = false end
            optionsMap[name] = entry
            optionsList[#optionsList + 1] = entry
            return entry
        end

        local function buildOptionRow(option, addToScroll)
            local row = E("TextButton", {
                Size = UDim2.new(1, 0, 0, 21),
                AutoButtonColor = false,
                Text = "",
                Elements = { Corner = UDim.new(0, 6) },
                ThemeTag = { BackgroundColor3 = "Colors.Buttons.Default" },
                Childs = {
                    E("Frame", {
                        Position = UDim2.new(0, 1, 0.5),
                        Size = UDim2.new(0, 4, 0, 4),
                        BackgroundTransparency = 1,
                        AnchorPoint = Vector2.new(0, 0.5),
                        Elements = { Corner = UDim.new(0.5, 0) },
                        ThemeTag = { BackgroundColor3 = "Colors.Primary" },
                    }),
                    E("TextLabel", {
                        Size = UDim2.fromScale(1, 1),
                        Position = UDim2.fromOffset(10, 0),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        BackgroundTransparency = 1,
                        TextTransparency = 0.4,
                        Text = option.DisplayName,
                        TextSize = 10,
                        ThemeTag = { Font = "Font.Bold", TextColor3 = "Colors.Text.Default" },
                    }),
                },
            })
            option.SearchText = M(option.DisplayName)
            option.Instance = row
            option.Instance.TextLabel = row:FindFirstChildOfClass("TextLabel")
            option.Instance.Frame = row:FindFirstChildOfClass("Frame")

            local last = 0
            row.Activated:Connect(function()
                if (tick() - last) < 0 then return end
                if popupRoot.Parent and not panelOpen then
                    last = tick() + 0.2
                    toggleOption(option)
                end
            end)

            if addToScroll then
                row.Parent = popupScroll
                if not popupSearchBox.Visible then setSelected(option, option.Selected) end
            end
        end

        local function clearOptions()
            for inst in pairs(optionInstances) do
                inst.Parent = nil
                optionInstances[inst] = nil
            end
        end

        local function matchesSearch(option, firstChar, query, searchText)
            local passes = true
            local q = query
            if firstChar == "+" or firstChar == "-" then
                passes = option.Selected == (firstChar == "+")
                q = query:sub(2, -1)
            end
            return passes and searchText:find(q, 1, true) ~= nil
        end

        local function applySearch()
            local query = popupSearchBox.Text
            local firstChar = string.sub(query, 1, 1)
            local cleaned = M(query)
            local empty = #cleaned == 0
            local visible = 0
            for i = 1, #optionsList do
                local option = optionsList[i]
                local pass = empty or matchesSearch(option, firstChar, cleaned, option.SearchText)
                if option.Instance then option.Instance.Visible = pass end
                if pass then visible += 1 end
            end
            applyPopupPosition(visible)
        end

        local function openDropdown(wantOpen)
            if opened == wantOpen then return end
            if not panelOpen then popupRoot.Parent = ScreenGui end

            if wantOpen then
                popupRoot.Parent = ScreenGui
                applyPopupPosition(#optionsList)
                opened = true
                dropdown.Opened = true
                arrowTag.ImageColor3 = "Colors.Primary"
                arrowTag.Image = "Icons.Dropdown.Close"
                J(arrow, "ImageColor3", resolvePath(Library.CurrentTheme, "Colors.Primary"), 0.35):Play()
                arrow.Image = resolvePath(Library.CurrentTheme, "Icons.Dropdown.Close")
                J(popupPanel, "Size", UDim2.fromOffset(PANEL_WIDTH, rowCountFor(#optionsList)), 0.3):Play()
            else
                task.spawn(closeSearch)
                panelOpen = true
                local tw = J(popupPanel, "Size", UDim2.fromOffset(PANEL_WIDTH, 0), 0.2)
                tw:Play(); tw.Completed:Wait()
                popupRoot.Parent = nil
                panelOpen = false
                opened = false
                dropdown.Opened = false
                arrowTag.ImageColor3 = "Colors.Icons"
                arrowTag.Image = "Icons.Dropdown.Open"
                J(arrow, "ImageColor3", resolvePath(Library.CurrentTheme, "Colors.Icons"), 0.35):Play()
                arrow.Image = resolvePath(Library.CurrentTheme, "Icons.Dropdown.Open")
            end
        end

        popupSearch.Activated:Connect(openSearch)
        popupSearchBox:GetPropertyChangedSignal("Text"):Connect(applySearch)

        box.Activated:Connect(function() openDropdown(not opened) end)

        UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if opened and not isMouseOverPanel() and not popupSearchBox:IsFocused() then
                openDropdown(false)
            end
        end)

        local function resolveOption(candidate, index)
            if index and type(candidate) == "boolean" then
                return candidate == true and optionsList[index]
            end
            if type(candidate) == "number" then return optionsList[candidate] end
            return optionsMap[tostring(candidate)]
        end

        local function markSelected(option)
            option.Selected = true
            if multiSelect then optionEnabled[option.Name] = true
            else selected = option end
        end

        local function selectDefault(candidate, index)
            local opt = resolveOption(candidate, index)
            if opt then markSelected(opt)
            elseif multiSelect and type(candidate) == "string" then
                optionEnabled[candidate] = true
            end
        end

        -- Apply defaults
        if default then
            for i = 1, (multiSelect and #default or 1) do
                selectDefault(default[i], i)
            end
        end

        dropdown.ADD_DROPDOWN_OPTION = function(name)
            if type(name) == "table" then
                for i = 1, #name do dropdown:Add(name[i]) end
                return
            end
            local opt = ensureOption(name)
            if not opt then return end
            if dropdown.Opened then buildOptionRow(opt, true) end
            local shouldSelect = false
            if multiSelect then
                shouldSelect = (optionEnabled[opt.Name] or (default and table.find(default, opt.Name))) == true
            else
                shouldSelect = selected and selected.Name == opt.Name
            end
            if shouldSelect then
                markSelected(opt)
                if opt.Instance then setSelected(opt, opt.Selected) end
            end
            scheduleDisplay()
        end

        dropdown.REMOVE_DROPDOWN_OPTION = function(name)
            local opt = optionsMap[tostring(name)]
            if not opt then return end
            local idx = table.find(optionsList, opt)
            if idx then table.remove(optionsList, idx) end
            if opt.Instance then opt.Instance:Destroy() end
            optionsMap[opt.Name] = nil
        end

        dropdown.CLEAR_DROPDOWN = function()
            for i = #optionsList, 1, -1 do
                local opt = optionsList[i]
                if opt.Instance then opt.Instance:Destroy() end
                optionsMap[opt.Name] = nil
                optionsList[i] = nil
            end
            if dropdown.Opened then clearOptions() end
        end

        if list then
            for i = 1, #list do ensureOption(list[i]) end
        end

        refreshDisplay()
        if flag ~= nil then
            Flags[flag] = multiSelect and optionEnabled or (selected and selected.Name)
        end

        return dropdown
    end

    -- ========================================================================================
