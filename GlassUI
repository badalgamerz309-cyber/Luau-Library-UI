local _lucideCache = nil
local function tryLoadLucide()
    if _lucideCache ~= nil then return _lucideCache end
    local ok, mod = pcall(function()
        local src = game:HttpGet(
            "https://raw.githubusercontent.com/latte-soft/lucide-roblox/main/lucide.lua"
        )
        return loadstring(src)()
    end)
    _lucideCache = ok and mod or false
    return _lucideCache
end

local function lucideAsset(name, size)
    if not name or name == "" then return nil end
    if O(name) then return name end
    local lib = tryLoadLucide()
    if lib and type(lib) == "table" and lib.GetAsset then
        local ok, asset = pcall(lib.GetAsset, name, size or 24)
        if ok and asset then
            return type(asset) == "table" and (asset.Image or asset.Icon) or tostring(asset)
        end
    end
    return nil
end

