local Window = {}
Window.__index = Window

function Window:CreateTab(opts)
    opts = opts or {}
    local name = opts.Name or opts[1] or "Tab"
    local iconName = opts.Icon or opts[2]

    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = Theme.ButtonDefault,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = self.TabContainer,
    })
    corner(btn, Theme.CornerSmall)

    if iconName then
        local ic = lucideIcon(iconName, 14, Theme.TextDarker)
        ic.Position = UDim2.new(0, 10, 0.5, -7)
        ic.Parent = btn
        btn:SetAttribute("IconInst", ic)
    end

    local label = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, iconName and 32 or 12, 0, 0),
        Font = Theme.FontMedium,
        TextSize = 12,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = name,
        Parent = btn,
    })

    local indicator = create("Frame", {
        Size = UDim2.fromOffset(4, 4),
        Position = UDim2.new(1, -10, 0.5, -2),
        BackgroundColor3 = Theme.Primary,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = btn,
    })
    corner(indicator, UDim.new(1, 0))

    local page = create("Frame", {
        Name = "Page",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = self.PageContainer,
    })
    local scroll = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.ScrollBar,
        ScrollBarImageTransparency = 0.2,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = page,
    })
    listLayout(scroll, 6)
    padding(scroll, 10, 10, 12, 12)

    local tab = setmetatable({
        Button = btn,
        Label = label,
        Indicator = indicator,
        Page = page,
        Container = scroll,
        Name = name,
        Window = self,
    }, Tab)

    btn.MouseEnter:Connect(function()
        if not tab._active then
            tween(btn, { BackgroundTransparency = 0.85 }, Theme.TweenFast)
        end
    end)
    btn.MouseLeave:Connect(function()
        if not tab._active then
            tween(btn, { BackgroundTransparency = 1 }, Theme.TweenFast)
        end
    end)

    btn.MouseButton1Click:Connect(function()
        for _, other in ipairs(self.Tabs) do
            other._active = false
            tween(other.Button, { BackgroundTransparency = 1 }, Theme.TweenFast)
            tween(other.Label, { TextColor3 = Theme.TextDim }, Theme.TweenFast)
            tween(other.Indicator, { BackgroundTransparency = 1, Size = UDim2.fromOffset(4, 4) }, Theme.TweenFast)
            local ic = other.Button:GetAttribute("IconInst")
            if ic and ic.Parent then tween(ic, { ImageColor3 = Theme.TextDarker }, Theme.TweenFast) end
            other.Page.Visible = false
        end
        tab._active = true
        tween(btn, { BackgroundTransparency = 0.75 }, Theme.TweenFast)
        tween(label, { TextColor3 = Theme.Text }, Theme.TweenFast)
        tween(indicator, { BackgroundTransparency = 0, Size = UDim2.fromOffset(4, 14) }, Theme.TweenSmooth)
        local ic = btn:GetAttribute("IconInst")
        if ic and ic.Parent then tween(ic, { ImageColor3 = Theme.Primary }, Theme.TweenFast) end
        page.Visible = true
        page.Size = UDim2.new(1, 0, 0, 0)
        tween(page, { Size = UDim2.new(1, 0, 1, 0) }, Theme.TweenSmooth)
    end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then btn.MouseButton1Click:Fire() end
    return tab
end

function Window:Minimize()
    if self.Minimized then return end
    self.Minimized = true
    self._fullSize = self.Main.Size
    local _, sy = self.Main.Position.Y.Scale, self.Main.Position.Y.Offset
    tween(self.Main, {
        Size = UDim2.fromOffset(self.Main.Size.X.Offset, 30),
        BackgroundTransparency = 0.9,
    }, Theme.TweenSmooth)
    if self.FloatingIcon then
        self.FloatingIcon.Visible = true
        self.FloatingIcon.Size = UDim2.fromOffset(0, 0)
        tween(self.FloatingIcon, { Size = UDim2.fromOffset(44, 44) }, Theme.TweenBounce)
    end
end

function Window:Restore()
    if not self.Minimized then return end
    self.Minimized = false
    if self.FloatingIcon then
        tween(self.FloatingIcon, { Size = UDim2.fromOffset(0, 0) }, Theme.TweenFast)
        task.wait(0.14)
        self.FloatingIcon.Visible = false
    end
    tween(self.Main, {
        Size = self._fullSize or UDim2.fromOffset(550, 380),
        BackgroundTransparency = Theme.WindowTransparency,
    }, Theme.TweenSmooth)
end

function Window:Destroy()
    for _, c in ipairs(self._connections or {}) do
        pcall(function() c:Disconnect() end)
    end
    if self.Gui then pcall(function() self.Gui:Destroy() end) end
end

