                Padding = {
                    PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
                    PaddingTop  = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
                },
                ListLayout = { Padding = UDim.new(0, 6) },
            },
        })

        local selectTweens = {
            J(indicator, "BackgroundTransparency", 0, 0.25),
            J(indicator, "Size", UDim2.fromOffset(4, 14), 0.25),
        }
        local unselectTweens = {
            J(indicator, "BackgroundTransparency", 1, 0.25),
            J(indicator, "Size", UDim2.fromOffset(4, 4), 0.25),
        }

        local renderer = RootThemeNode:new()
        TabRenderers[tab] = renderer

        local function playBatch(list)
            for i = 1, #list do list[i]:Play() end
        end

        local function select()
            playBatch(selectTweens)
            tab.Selected = true
            renderer:changeRendering(true)
            renderer:update()
            page.Visible = true
            J(btn, "BackgroundTransparency", 0.5, 0.2):Play()
            if iconImg then J(iconImg, "ImageColor3", Library.CurrentTheme.Colors.Primary, 0.2):Play() end
        end

        local function unselect()
            playBatch(unselectTweens)
            tab.Selected = false
            page.Visible = false
            J(btn, "BackgroundTransparency", 1, 0.2):Play()
            if iconImg then J(iconImg, "ImageColor3", Library.CurrentTheme.Colors.Icons, 0.2):Play() end
            renderer:changeRendering(false)
        end

        TabSelectors[tab] = table.freeze({ Select = select, Unselect = unselect })
        TabElements[tab] = table.freeze({ SelectTabButton = btn, Container = scroll, Page = page })

        table.insert(TabsList, tab)

        btn.Activated:Connect(function() tab:Select() end)
        if tab.Selected then tab:Select() end

        return tab
    end

