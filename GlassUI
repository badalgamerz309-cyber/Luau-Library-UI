-- ============================================================================================
-- § 4. THEME TAG SYSTEM
-- ============================================================================================
-- Every GUI object that cares about the theme registers a "tag table":
--     { PropertyName = "Theme.Path.To.Value", ... }
-- When the theme changes, C:update() walks all descendants and re-applies.

local ThemeNode = {}
ThemeNode.__index = ThemeNode

-- Resolve a dotted path like "Colors.Text.Default" against a theme root.
local function resolvePath(root, path)
    for segment in path:gmatch("[^%.]+") do
        if root == nil then return nil end
        root = root[segment]
    end
    return root
end

-- Apply a single tag entry to an instance.
local function applyTagEntry(inst, prop, path, theme)
    if theme == nil then theme = Library.CurrentTheme end
    if theme == nil then return end
    local value = resolvePath(theme, type(path) == "function" and path() or path)
    if value ~= nil then
        inst[prop] = value
    end
end

-- Apply a whole tag table.
local function applyTag(theme, inst, tag)
    for prop, path in pairs(tag) do
        applyTagEntry(inst, prop, path, theme)
    end
end

-- Write a file, creating parent folders as needed.
local function writeFileSafe(path, content)
    if _makefolder then
        local parts = path:split("/")
        parts[#parts] = nil
        local dir = table.concat(parts, "/")
        if dir ~= "" and (isfolder == nil or not isfolder(dir)) then
            _makefolder(dir)
        end
    end
    if _writefile then _writefile(path, content) end
end

-- Global flag indicating a drag is in progress (blocks other drags)
local IS_DRAGGING_GLOBAL = false

-- Numeric bounds for UI scale
local UI_SCALE = {
    MAX_SCALE = 1.6,
    MIN_SCALE = 0.6,
    TEXTBOX   = { PLACEHOLDER_TEXT = "Input" },
}

function ThemeNode:add(descendant, tag)
    self.Descendants[tag] = descendant
    if self.IS_RENDERING then
        applyTag(Library.CurrentTheme, descendant, tag)
    end
end

function ThemeNode:update()
    if self.IS_RENDERING and not self.UPDATED_OBJECTS then
        local theme = Library.CurrentTheme
        self.UPDATED_OBJECTS = true
        for tag, descendant in pairs(self.Descendants) do
            if typeof(descendant) == "table" and descendant.update then
                descendant:update()
            else
                applyTag(theme, descendant, tag)
            end
        end
    end
end

function ThemeNode:destroy()
    if self.Parent then
        local idx = table.find(self.Parent.Descendants, self)
        if idx then table.remove(self.Parent.Descendants, idx) end
    end
    table.clear(self.Descendants)
    setmetatable(self, nil)
end

function ThemeNode:changeRendering(state)
    if self.IS_RENDERING ~= state then
        self.IS_RENDERING = state
        self.UPDATED_OBJECTS = false
    end
end

function ThemeNode:new()
    local child = setmetatable({
        IS_RENDERING = true,
        UPDATED_OBJECTS = false,
        Descendants = {},
        Parent = self.Descendants ~= nil and self or nil,
    }, ThemeNode)
    if self.Descendants then
        table.insert(self.Descendants, child)
    end
    return child
end

-- Root theme node
local RootThemeNode = ThemeNode:new()

