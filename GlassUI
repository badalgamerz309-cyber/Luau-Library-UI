function s:GetIconByName(name)
    if name == nil then return end
    assert(name, "Library.GetIconByName expects string")

    if O(name) or #name == 0 then return name end

    local key = M(name)
    if self.Icons[key] then return "rbxassetid://" .. self.Icons[key] end

    for k, v in self.Icons do
        if k:find(key, 1, true) then return "rbxassetid://" .. v end
    end

    -- Try Lucide
    local lucide = lucideAsset(name, 24)
    if lucide then return lucide end

    return nil
end

function s:IsValidTheme(name)
    assert(type(name) == "string", "Library.IsValidTheme expects string")
    return self.Themes[name] ~= nil
end

function s:GetThemes()
    local list = {}
    for name in self.Themes do table.insert(list, name) end
    return list
end

function s:GetTheme(name)
    assert(name == nil or type(name) == "string", "Library.GetTheme expects string or nil")
    if name == nil then return self.CurrentTheme end
    local theme = self.Themes[name]
    assert(theme ~= nil, "Library.GetTheme: theme not found: " .. name)
    return theme
end

function s:SetTheme(name)
    assert(type(name) == "string", "Library.SetTheme expects string")
    local theme = self.Themes[name]
    assert(theme, "Library.SetTheme: theme not found: " .. name)
    self.CurrentTheme = theme
    self.WindowSettings.SelectedTheme = theme.Name
    C:update()
end

function s:SetUIScale(scale)
    assert(type(scale) == "number", "Library.SetUIScale expects number")
    assert(scale >= B.MIN_SCALE and scale <= B.MAX_SCALE,
        ("Library.SetUIScale: Min %s, Max %s"):format(B.MIN_SCALE, B.MAX_SCALE))
    I.Scale.Scale = P(scale)
end

function s:GetMaxScale() return B.MAX_SCALE end
function s:GetMinScale() return B.MIN_SCALE end

function s:GetCurrentTheme()
    if not self.LOADED_UI_LIBRARY then
        error("Library: UI is not loaded", 2)
    end
    return self.CurrentTheme
end

function s:Destroy()
    for _, conn in self.Connections do
        conn:Disconnect()
    end
    if I and I:GetAttribute"UID" == self.SCREENGUI_UID then
        pcall(I.Destroy, I)
    end
end

function s:MakeWindow(opts)
    if self.LOADED_UI_LIBRARY then
        return error("Library: only one window allowed", 2)
    end

    local uid = math.random()
    I:SetAttribute("UID", uid)
    self.SCREENGUI_UID = uid
    I:ClearAllChildren()

    local uiScale = E("UIScale", "Scale", I, { Scale = P(1) })

    local config = {
        Title        = opts[1] or opts.Name or opts.Title,
        SubTitle     = opts[2] or opts.SubName or opts.SubTitle,
        ScriptFolder = opts[3] or opts.ScriptFolder or opts.FolderName,
        BackgroundImage = opts[4] or opts.BackgroundImage or opts.Background,
        FloatingIcon = opts[5] or opts.FloatingIcon or opts.MinimizedIcon,
    }

    assert(type(config.Title) == "string", "Window.Title must be string")
    assert(type(config.SubTitle) == "string", "Window.SubTitle must be string")
    if config.ScriptFolder ~= nil then
        assert(type(config.ScriptFolder) == "string", "Window.ScriptFolder must be string or nil")
        assert(not string.find(config.ScriptFolder, "/"), "Window.ScriptFolder must not contain '/'")
    end

    -- Persistent settings
    local windowSettings = (function()
        local folder = config.ScriptFolder
        local dirty = false

        local ok, data = pcall(function()
            return folder and k:JSONDecode(f(("%s/LibrarySettings.json"):format(folder)))
        end)
        if type(data) ~= "table" then data = {} end

        local function flush()
            dirty = false
            return pcall(function()
                return z(("%s/LibrarySettings.json"):format(folder), k:JSONEncode(data))
            end)
        end

        local function setter(_, key, value)
            rawset(data, key, value)
            if folder and not dirty then
                dirty = true
                task.delay(0.5, flush)
            end
        end

        return setmetatable({}, { __newindex = setter, __index = data })
    end)()

    local flags = (function()
        local folder = config.ScriptFolder
        local dirty = false

        local ok, data = pcall(function()
            return folder and k:JSONDecode(f(("%s/ScriptFlags.json"):format(folder)))
        end)
        if type(data) ~= "table" then data = {} end

        local function flush()
            dirty = false
            return pcall(function()
                z(("%s/ScriptFlags.json"):format(folder), k:JSONEncode(data))
            end)
        end

        local function setter(_, key, value)
            rawset(data, key, value)
            if folder and not dirty then
                dirty = true
                task.delay(0.5, flush)
            end
        end

        local function clear()
            table.clear(data)
            return pcall(function()
                return folder and c(("%s/ScriptFlags.json"):format(folder))
            end)
        end

        return setmetatable({}, { __newindex = setter, __call = clear, __index = data })
    end)()

    self.ThemesObjects = C
    self.WindowSettings = windowSettings
    self.Flags = flags

    -- Icons file
    self.Icons = (function()
        local folder = config.ScriptFolder

        local ok, loaded = pcall(function()
            return loadstring(f(("%s/Icons.lua"):format(folder)))()
        end)
        if ok and type(loaded) == "table" then return loaded end

        local ownerUrl = ("https://raw.githubusercontent.com/%s"):format(self.Information.GitHubOwner)
        local iconUrl = ("%s/Library/refs/heads/main/redz-V5-remake/Utils/Icons.lua"):format(ownerUrl)
        local src
        local function persist()
            return z(("%s/Icons.lua"):format(folder), src)
        end

        local ok2, result = pcall(function()
            src = game:HttpGet(iconUrl)
            return loadstring(src)()
        end)

        if ok2 and type(result) == "table" then
            if type(src) == "string" then pcall(persist) end
            return result
        end

        return {}
    end)()

    -- Apply saved theme
    if type(windowSettings.SelectedTheme) == "string" and self:IsValidTheme(windowSettings.SelectedTheme) then
