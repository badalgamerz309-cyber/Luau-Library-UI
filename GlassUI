    function classWindow:MinimizeButton()
        if not MinimizeBtn then return end
        if (tick() - (self._minDebounce or 0)) < 0 then return false end

        if self.Minimized then
            MinimizeBtn.Image = Library.CurrentTheme.Icons.Minimize
            J(MainFrame, "Size", self._savedSize or Library.Default.UISize, 0.3):Play()
        else
            self._savedSize = MainFrame.Size
            MinimizeBtn.Image = Library.CurrentTheme.Icons.Restore
            J(MainFrame, "Size", UDim2.fromOffset(MainFrame.Size.X.Offset, TopBar.Size.Y.Offset), 0.3):Play()
        end

        for _, r in ipairs(Resizers) do r.Visible = self.Minimized end

        self.Minimized = not self.Minimized
        self._minDebounce = tick() + 0.5
        return true
    end

