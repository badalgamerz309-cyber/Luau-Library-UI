    winObj.SUBTITLE_LABEL = titleLbl.SubTitle
    winObj.TITLE_LABEL = titleLbl
    winObj._floatIconImage = config.FloatingIcon

    winObj:StartWindow({
        Resizers = { sizeResizer, tabResizer },
        MinimizeButton = minimizeBtn,
        Dropdowns = dropdownFolder,
        MainFrame = mainFrame,
        TopBar = topBar,
        SubTitle = titleLbl.SubTitle,
        Title = titleLbl,
        UIScale = uiScale,
        Flags = flags,
    })

    u(minimizeBtn.Activated, function() winObj:MinimizeButton() end)
    u(closeBtn.Activated, function() winObj:Dialog(closeDialog) end)

    return winObj
end

return s
