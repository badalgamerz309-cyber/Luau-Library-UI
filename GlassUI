function GlassUI:CreateWindow(opts)
    opts = opts or {}
    local title    = opts.Title or "GlassUI"
    local subtitle = opts.Subtitle or "v1.0.0"
    local size     = opts.Size or UDim2.fromOffset(560, 400)
    local position = opts.Position or UDim2.fromScale(0.5, 0.5)
    local bgImage  = opts.BackgroundImage     -- optional rbxassetid string
    local floatImg = opts.FloatingIcon        -- optional rbxassetid string
    local keybind  = opts.ToggleKeybind       -- optional Enum.KeyCode

    local gui = create("ScreenGui", {
        Name = "GlassUI_" .. title:gsub("%s+", "_"),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        Parent = GUI_PARENT,
    })

    local main = create("Frame", {
        Name = "Main",
        Size = size,
        Position = position,
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(28, 28, 34),
        BackgroundTransparency = Theme.WindowTransparency,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true,
        Parent = gui,
    })
    corner(main, Theme.Corner)
    stroke(main, Theme.Stroke, 1, 0.5)
    gradient(main, Theme.BackgroundGradient, Theme.GradientRotation)

    -- Custom background image
    if bgImage and type(bgImage) == "string" then
        local bg = create("ImageLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = bgImage,
            ImageTransparency = 0.4,
            ScaleType = Enum.ScaleType.Crop,
            ZIndex = 0,
            Parent = main,
        })
        corner(bg, Theme.Corner)
    end

    -- Top bar
    local topBar = create("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        Parent = main,
    })

    local titleLbl = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 0, 16),
        AutomaticSize = Enum.AutomaticSize.X,
        Position = UDim2.new(0, 14, 0.5, -8),
        Font = Theme.FontBold,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = title,
        Parent = topBar,
    })

    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 0, 10),
        AutomaticSize = Enum.AutomaticSize.X,
        Position = UDim2.new(0, titleLbl.Position.X.Offset + 10, 0.5, -2),
        Font = Theme.Font,
        TextSize = 9,
        TextColor3 = Theme.TextDarker,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = subtitle,
        Parent = topBar,
    })

    -- Control buttons
    local function miniBtn(name, xOff, dotColor)
        local b = create("TextButton", {
            Name = name,
            Size = UDim2.fromOffset(12, 12),
            Position = UDim2.new(1, xOff, 0.5, -6),
            BackgroundColor3 = dotColor,
            BackgroundTransparency = 0.1,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            Parent = topBar,
        })
        corner(b, UDim.new(1, 0))
        b.MouseEnter:Connect(function()
            tween(b, { BackgroundTransparency = 0 }, Theme.TweenFast)
        end)
        b.MouseLeave:Connect(function()
            tween(b, { BackgroundTransparency = 0.1 }, Theme.TweenFast)
        end)
        return b
    end

    local closeBtn = miniBtn("Close",   -14, Theme.Error)
    local minBtn   = miniBtn("Minimize",-32, Theme.Warning)

    -- Body
    local body = create("Frame", {
        Name = "Body",
        Size = UDim2.new(1, 0, 1, -36),
        Position = UDim2.new(0, 0, 0, 34),
        BackgroundTransparency = 1,
        Parent = main,
    })

    -- Left tabs panel
    local tabPanel = create("Frame", {
        Size = UDim2.new(0, 160, 1, 0),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.96,
        BorderSizePixel = 0,
        Parent = body,
    })
    corner(tabPanel, Theme.CornerSmall)
    stroke(tabPanel, Theme.Stroke, 1, 0.7)

    local tabScroll = create("ScrollingFrame", {
        Size = UDim2.new(1, -8, 1, -16),
        Position = UDim2.new(0, 4, 0, 8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.ScrollBar,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = tabPanel,
    })
    listLayout(tabScroll, 3)
    padding(tabScroll, 2, 2, 4, 4)

    -- Right page panel
    local pagePanel = create("Frame", {
        Size = UDim2.new(1, -168, 1, 0),
        Position = UDim2.new(0, 168, 0, 0),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.96,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = body,
    })
    corner(pagePanel, Theme.CornerSmall)
    stroke(pagePanel, Theme.Stroke, 1, 0.7)

    -- Floating restore icon
    local floatIcon = create("TextButton", {
        Name = "FloatingIcon",
        Size = UDim2.fromOffset(44, 44),
        Position = UDim2.new(1, -20, 0, 20),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = Theme.Primary,
        BackgroundTransparency = 0.05,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Visible = false,
        Parent = gui,
    })
    corner(floatIcon, UDim.new(1, 0))
    stroke(floatIcon, Theme.PrimaryHover, 1, 0.3)

    if floatImg then
        create("ImageLabel", {
            Size = UDim2.fromScale(0.55, 0.55),
            Position = UDim2.fromScale(0.225, 0.225),
            BackgroundTransparency = 1,
            Image = floatImg,
            Parent = floatIcon,
        })
    else
        create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Theme.FontBold,
            TextSize = 18,
            TextColor3 = Theme.Text,
            Text = string.upper(string.sub(title, 1, 1)),
            Parent = floatIcon,
        })
    end

    -- Build window object
    local win = setmetatable({
        Gui = gui,
        Main = main,
        Tabs = {},
        TabContainer = tabScroll,
        PageContainer = pagePanel,
        FloatingIcon = floatIcon,
        Minimized = false,
        _connections = {},
    }, Window)

    -- Draggable window
    makeDraggable(topBar, main, 0.35)

    -- Draggable floating icon
    makeDraggable(floatIcon, floatIcon, 0.35)

    -- Close / Minimize
    closeBtn.MouseButton1Click:Connect(function()
        tween(main, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, Theme.TweenNormal)
        task.wait(0.25)
        win:Destroy()
    end)

    minBtn.MouseButton1Click:Connect(function()
        win:Minimize()
    end)

    floatIcon.MouseButton1Click:Connect(function()
        win:Restore()
    end)

    -- Keybind toggle minimize/restore
    if keybind then
        table.insert(win._connections, UserInputService.InputBegan:Connect(function(input, gameProc)
            if gameProc then return end
            if input.KeyCode == keybind then
                if win.Minimized then win:Restore() else win:Minimize() end
            end
        end))
    end

    return win
end

