function Tab:CreateMultiTab(opts)
    opts = opts or {}
    local names = opts.Tabs or opts.Options or {}
    local callback = opts.Callback

    local frame = create("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.96,
        BorderSizePixel = 0,
        Parent = self.Container,
    })
    corner(frame, Theme.CornerSmall)
    stroke(frame, Theme.Stroke, 1, 0.7)
    local ll = listLayout(frame, 3, Enum.FillDirection.Horizontal)
    ll.VerticalAlignment = Enum.VerticalAlignment.Center
    padding(frame, 3, 3, 4, 4)

    local buttons = {}
    for i, name in ipairs(names) do
        local btn = create("TextButton", {
            Size = UDim2.new(1 / #names, -3, 1, 0),
            BackgroundTransparency = i == 1 and 0.7 or 1,
            BackgroundColor3 = Theme.Primary,
            Text = name,
            Font = Theme.FontMedium,
            TextSize = 12,
            TextColor3 = i == 1 and Theme.Text or Theme.TextDim,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            Parent = frame,
        })
        corner(btn, Theme.CornerSmall)

        btn.MouseButton1Click:Connect(function()
            for j, other in ipairs(buttons) do
                tween(other, {
                    BackgroundTransparency = (j == i) and 0.7 or 1,
                    TextColor3 = (j == i) and Theme.Text or Theme.TextDim,
                }, Theme.TweenFast)
            end
            if callback then task.spawn(callback, i, name) end
        end)
        table.insert(buttons, btn)
    end

    return frame
end

function Tab:CreateButton(opts)
    opts = opts or {}
    local name = opts.Name or opts[1] or "Button"
    local callback = opts.Callback or opts[2]
    local iconName = opts.Icon

    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Theme.ButtonDefault,
        BackgroundTransparency = Theme.ButtonTransparency,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = self.Container,
    })
    corner(btn, Theme.CornerSmall)
    stroke(btn, Theme.Stroke, 1, 0.55)

    if iconName then
        local ic = lucideIcon(iconName, 16, Theme.Icons)
        ic.Position = UDim2.new(0, 12, 0.5, -8)
        ic.Parent = btn
    end

    local label = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, iconName and 36 or 12, 0, 0),
        Font = Theme.FontMedium,
        TextSize = 13,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = name,
        Parent = btn,
    })

    btn.MouseEnter:Connect(function()
        tween(btn, { BackgroundColor3 = Theme.ButtonHolding, BackgroundTransparency = 0 }, Theme.TweenFast)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, { BackgroundColor3 = Theme.ButtonDefault, BackgroundTransparency = Theme.ButtonTransparency }, Theme.TweenFast)
    end)
    btn.MouseButton1Click:Connect(function()
        tween(btn, { Size = UDim2.new(1, -8, 0, 30) }, Theme.TweenFast)
        task.wait(0.1)
        tween(btn, { Size = UDim2.new(1, 0, 0, 34) }, Theme.TweenBounce)
        if callback then task.spawn(callback) end
    end)

    return setmetatable({
        DestroyElement = btn,
        VisibleElement = btn,
        TitleLabel = label,
    }, Option)
end

function Tab:CreateToggle(opts)
    opts = opts or {}
    local name    = opts.Name or opts[1] or "Toggle"
    local default = opts.Default or opts[2] or false
    local callback= opts.Callback or opts[3]
    local iconName= opts.Icon

    local state = default

    local frame = create("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        Parent = self.Container,
    })

    if iconName then
        local ic = lucideIcon(iconName, 16, Theme.Icons)
        ic.Position = UDim2.new(0, 0, 0.5, -8)
        ic.Parent = frame
    end

    local label = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, iconName and 26 or 0, 0, 0),
        Font = Theme.FontMedium,
        TextSize = 13,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = name,
        Parent = frame,
    })

    local track = create("Frame", {
        Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -40, 0.5, -10),
        BackgroundColor3 = state and Theme.Primary or Theme.Stroke,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Parent = frame,
    })
    corner(track, Theme.CornerRound)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(knob, Theme.CornerRound)

    local btn = create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame,
    })

    local function set(v, silent)
        state = v
        tween(track, { BackgroundColor3 = state and Theme.Primary or Theme.Stroke }, Theme.TweenFast)
        tween(knob, {
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        }, Theme.TweenBounce)
        if not silent and callback then task.spawn(callback, state) end
    end

    btn.MouseButton1Click:Connect(function() set(not state) end)

    return setmetatable({
        Value = state,
        Set = set,
        Get = function() return state end,
        DestroyElement = frame,
        VisibleElement = frame,
        TitleLabel = label,
    }, Option)
end

