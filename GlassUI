-- ============================================================================================

function Library:GetIconByName(name)
    if name == nil then return nil end
    if O(name) or #name == 0 then return name end

    local key = M(name)
    if self.Icons[key] then return "rbxassetid://" .. self.Icons[key] end

    for k2, v2 in pairs(self.Icons) do
        if type(k2) == "string" and k2:find(key, 1, true) then
            return "rbxassetid://" .. v2
        end
    end

    local lucide = lucideAsset(name, 24)
    if lucide then return lucide end
    return nil
end

function Library:IsValidTheme(name)
    assert(type(name) == "string", "Library.IsValidTheme expects string")
    return self.Themes[name] ~= nil
end

function Library:GetThemes()
    local list = {}
    for name in pairs(self.Themes) do table.insert(list, name) end
    return list
end

function Library:GetTheme(name)
    assert(name == nil or type(name) == "string", "Library.GetTheme expects string or nil")
    if name == nil then return self.CurrentTheme end
    local theme = self.Themes[name]
    assert(theme ~= nil, "Library.GetTheme: theme not found: " .. name)
    return theme
end

function Library:SetTheme(name)
    assert(type(name) == "string", "Library.SetTheme expects string")
    local theme = self.Themes[name]
    assert(theme, "Library.SetTheme: theme not found: " .. name)
    self.CurrentTheme = theme
    if self.WindowSettings then
        self.WindowSettings.SelectedTheme = theme.Name
    end
    RootThemeNode:update()
end

function Library:SetUIScale(scale)
    assert(type(scale) == "number", "Library.SetUIScale expects number")
    assert(scale >= UI_SCALE.MIN_SCALE and scale <= UI_SCALE.MAX_SCALE,
        ("Library.SetUIScale: Min %s, Max %s"):format(UI_SCALE.MIN_SCALE, UI_SCALE.MAX_SCALE))
    ScreenGui.Scale.Scale = P(scale)
end

function Library:GetMaxScale() return UI_SCALE.MAX_SCALE end
function Library:GetMinScale() return UI_SCALE.MIN_SCALE end

function Library:GetCurrentTheme()
    if not self.LOADED_UI_LIBRARY then error("Library: UI is not loaded", 2) end
    return self.CurrentTheme
end

function Library:Destroy()
    for _, conn in ipairs(self.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    if ScreenGui and ScreenGui:GetAttribute("UID") == self.SCREENGUI_UID then
        pcall(function() ScreenGui:Destroy() end)
    end
end

function Library:MakeWindow(opts)
    if self.LOADED_UI_LIBRARY then
        return error("Library: only one window allowed", 2)
    end

    local uid = math.random()
    ScreenGui:SetAttribute("UID", uid)
    self.SCREENGUI_UID = uid
    ScreenGui:ClearAllChildren()

    local uiScale = E("UIScale", "Scale", ScreenGui, { Scale = P(1) })

    local config = {
        Title           = opts[1] or opts.Name or opts.Title,
        SubTitle        = opts[2] or opts.SubName or opts.SubTitle,
        ScriptFolder    = opts[3] or opts.ScriptFolder or opts.FolderName,
        BackgroundImage = opts[4] or opts.BackgroundImage or opts.Background,
        FloatingIcon    = opts[5] or opts.FloatingIcon or opts.MinimizedIcon,
    }

    assert(type(config.Title) == "string", "Window.Title must be string")
    assert(type(config.SubTitle) == "string", "Window.SubTitle must be string")
    if config.ScriptFolder ~= nil then
        assert(type(config.ScriptFolder) == "string", "Window.ScriptFolder must be string or nil")
        assert(not string.find(config.ScriptFolder, "/"), "Window.ScriptFolder must not contain '/'")
    end

    -- Persistent settings proxy
    local windowSettings = (function()
        local folder = config.ScriptFolder
        local dirty = false
        local ok, data = pcall(function()
            return folder and _readfile and HttpService:JSONDecode(_readfile(("%s/LibrarySettings.json"):format(folder)))
        end)
        if type(data) ~= "table" then data = {} end

        local function flush()
            dirty = false
            return pcall(function()
                return writeFileSafe(("%s/LibrarySettings.json"):format(folder), HttpService:JSONEncode(data))
            end)
        end

        local function setter(_, key, value)
            rawset(data, key, value)
            if folder and not dirty then
                dirty = true
                task.delay(0.5, flush)
            end
        end

        return setmetatable({}, { __newindex = setter, __index = data })
    end)()

    -- Persistent flags proxy
    local flags = (function()
        local folder = config.ScriptFolder
        local dirty = false
        local ok, data = pcall(function()
            return folder and _readfile and HttpService:JSONDecode(_readfile(("%s/ScriptFlags.json"):format(folder)))
        end)
        if type(data) ~= "table" then data = {} end

        local function flush()
            dirty = false
            return pcall(function()
                writeFileSafe(("%s/ScriptFlags.json"):format(folder), HttpService:JSONEncode(data))
            end)
        end

        local function setter(_, key, value)
            rawset(data, key, value)
            if folder and not dirty then
                dirty = true
                task.delay(0.5, flush)
            end
        end

        local function clear()
            table.clear(data)
            return pcall(function()
                return folder and _delfile and _delfile(("%s/ScriptFlags.json"):format(folder))
            end)
        end

        return setmetatable({}, { __newindex = setter, __call = clear, __index = data })
    end)()

    self.ThemesObjects = RootThemeNode
    self.WindowSettings = windowSettings
    self.Flags = flags

    -- Icons (fetch from redz repo, cache locally)
    self.Icons = (function()
        local folder = config.ScriptFolder
        local ok, loaded = pcall(function()
            return _readfile and loadstring(_readfile(("%s/Icons.lua"):format(folder)))()
        end)
        if ok and type(loaded) == "table" then return loaded end

        local ownerUrl = ("https://raw.githubusercontent.com/%s"):format(self.Information.GitHubOwner)
        local iconUrl  = ("%s/Library/refs/heads/main/redz-V5-remake/Utils/Icons.lua"):format(ownerUrl)
        local src
        local ok2, result = pcall(function()
            src = game:HttpGet(iconUrl)
            return loadstring(src)()
        end)
        if ok2 and type(result) == "table" then
            if type(src) == "string" and folder and _writefile then
                pcall(function() writeFileSafe(("%s/Icons.lua"):format(folder), src) end)
            end
            return result
        end
        return {}
    end)()

    -- Restore theme
    if type(windowSettings.SelectedTheme) == "string" and self:IsValidTheme(windowSettings.SelectedTheme) then
        self:SetTheme(windowSettings.SelectedTheme)
    else
        self:SetTheme(self.Default.Theme)
    end

    self.LOADED_UI_LIBRARY = true

    -- Window size
    local windowSize = self.Default.UISize
    if windowSettings and type(windowSettings.UISize) == "table" then
        local w2, h2 = unpack(windowSettings.UISize)
        if type(w2) == "number" and type(h2) == "number" then
            w2 = clamp(w2, 430, 1000)
            h2 = clamp(h2, 240, 560)
            windowSize = UDim2.fromOffset(w2, h2)
        end
    end

    -- Main window frame
    local mainFrame = E("Frame", "Window", ScreenGui, {
        Position = UDim2.new(0.5, -windowSize.X.Offset / 2, 0.5, -windowSize.Y.Offset / 2),
        Active = true,
        Size = windowSize,
        ThemeTag = { BackgroundTransparency = "BackgroundTransparency" },
        Elements = {
            Corner = self.CurrentTheme.CornerRadius,
            Gradient = { Rotation = self.CurrentTheme.GradientRotation, ThemeTag = { Color = "Colors.Background" } },
            Stroke = { Thickness = 1, ThemeTag = { Color = "Colors.Stroke" } },
        },
    })

    -- Optional custom background image
    if config.BackgroundImage and type(config.BackgroundImage) == "string" then
        local bg = E("ImageLabel", "BgImage", mainFrame, {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = config.BackgroundImage,
            ImageTransparency = 0.45,
            ScaleType = Enum.ScaleType.Crop,
            ZIndex = 0,
        })
        E("UICorner", bg, { CornerRadius = self.CurrentTheme.CornerRadius })
    end

    mainFrame.Destroying:Connect(function() self:Destroy() end)
    ScreenGui:GetAttributeChangedSignal("UID"):Connect(function()
        self:Destroy()
        mainFrame:Destroy()
    end)

    -- The FIX: colon syntax passes D as self; target is explicitly mainFrame.
    D:Draggable(mainFrame, uiScale, 0.5)

    local components = E("Folder", "Components", mainFrame)
    local dropdownFolder = E("Folder", "Dropdowns", ScreenGui)

    -- Top bar
    local topBar = E("Frame", "TopBar", components, {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
    })

    local titleLbl = E("TextLabel", "Title", topBar, {
        TextXAlignment = Enum.TextXAlignment.Left,
        AutomaticSize = Enum.AutomaticSize.XY,
        Position = UDim2.new(0, 15, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        Text = config.Title,
        TextSize = 13,
        BackgroundTransparency = 1,
        ThemeTag = { TextColor3 = "Colors.Text.Default", Font = "Font.Bold" },
        Childs = {
            E("TextLabel", "SubTitle", {
                Size = UDim2.fromScale(0, 1),
                AutomaticSize = Enum.AutomaticSize.X,
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(1, 6, 0.9),
                Text = config.SubTitle,
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Bottom,
                TextSize = 9,
                ThemeTag = { TextColor3 = "Colors.Text.Dark", Font = "Font.Normal" },
            }),
        },
    })

    local buttonsFolder = E("Folder", "Buttons", topBar, {
        Childs = {
            E("ImageButton", "Close", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = UDim2.new(1, -10, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundTransparency = 1,
                AutoButtonColor = false,
                ThemeTag = { Image = "Icons.Close" },
            }),
            E("ImageButton", "Minimize", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = UDim2.new(1, -36, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundTransparency = 1,
                Image = self.CurrentTheme.Icons.Minimize,
                AutoButtonColor = false,
            }),
        },
    })

    local minimizeBtn = buttonsFolder.Minimize
    local closeBtn = buttonsFolder.Close

    local winObj = setmetatable(config, { __index = ClassRegistry.Window })

    local tabScroll, pageHolder = buildTabLayout(config, topBar)
    tabScroll.Parent = components
    pageHolder.Parent = components

    local frozenElements = table.freeze({
        ContainerHolder = pageHolder,
        TabsContainer = tabScroll,
        Components = components,
        MainFrame = mainFrame,
    })

    function winObj:GetElements() return frozenElements end

    -- Resizers
    local sizeResizer = E("Frame", "ControlWindowSize", mainFrame, {
        Size = UDim2.new(0, 35, 0, 35),
        Position = mainFrame.Size,
        AnchorPoint = Vector2.new(0.8, 0.8),
        BackgroundTransparency = 1,
        Active = true,
        Elements = { Corner = self.CurrentTheme.CornerRadiusSmall },
        ThemeTag = { BackgroundColor3 = "Colors.OnPrimary" },
    })

    local tabResizer = E("Frame", "ControlTabsSize", mainFrame, {
        Size = UDim2.new(0, 16, 0.75, -30),
        Position = UDim2.new(0, tabScroll.Size.X.Offset, 0.5, 15),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Active = true,
        Elements = { Corner = self.CurrentTheme.CornerRadiusSmall },
        ThemeTag = { BackgroundColor3 = "Colors.OnPrimary" },
    })

    local function flashResizer(resizer)
        local last = resizer:GetAttribute("Resizing")
        resizer:SetAttribute("Resizing", tick())
        if last and (tick() - last) <= 0.1 then return end
        J(resizer, "BackgroundTransparency", 0.5, 0.3):Play()
        while tick() - resizer:GetAttribute("Resizing") <= 0.1 do task.wait() end
        J(resizer, "BackgroundTransparency", 1, 0.4):Play()
    end

    sizeResizer:GetPropertyChangedSignal("Position"):Connect(function()
        flashResizer(sizeResizer)
        local pos = sizeResizer.Position
        mainFrame.Size = pos
        windowSettings.UISize = { pos.X.Offset, pos.Y.Offset }
    end)

    tabResizer:GetPropertyChangedSignal("Position"):Connect(function()
        flashResizer(tabResizer)
        local pos = tabResizer.Position
        tabScroll.Size = UDim2.new(0, pos.X.Offset, 1, -topBar.Size.Y.Offset)
        pageHolder.Size = UDim2.new(1, -tabScroll.Size.X.Offset, 1, -topBar.Size.Y.Offset)
        windowSettings.TabSize = pos.X.Offset
    end)

    D:Draggable(sizeResizer, uiScale, 0.68, function(_, oX, _, oY)
        return UDim2.fromOffset(clamp(oX, 430, 1000), clamp(oY, 240, 560))
    end)

    D:Draggable(tabResizer, uiScale, 0.68, function(_, oX)
        return UDim2.new(0, clamp(oX, 135, 220), 0.5, 15)
    end)

    -- Close dialog preset
    local closeDialog = {
        Title = "Close Window?",
        Content = "Do you want to close the UI?",
        Options = {
            { Title = "Yes", Callback = function() self:Destroy() end },
            { Title = "No" },
        },
    }

    minimizeBtn.MouseEnter:Connect(function() J(minimizeBtn, "BackgroundTransparency", 0.4, 0.2):Play() end)
    minimizeBtn.MouseLeave:Connect(function() J(minimizeBtn, "BackgroundTransparency", 1, 0.2):Play() end)
    closeBtn.MouseEnter:Connect(function() J(closeBtn, "BackgroundTransparency", 0.4, 0.2):Play() end)
    closeBtn.MouseLeave:Connect(function() J(closeBtn, "BackgroundTransparency", 1, 0.2):Play() end)

    winObj.SetUIScale = self.SetUIScale
    winObj.SUBTITLE_LABEL = titleLbl.SubTitle
    winObj.TITLE_LABEL = titleLbl
    winObj._floatIconImage = config.FloatingIcon

    winObj:StartWindow({
        Resizers = { sizeResizer, tabResizer },
        MinimizeButton = minimizeBtn,
        Dropdowns = dropdownFolder,
        MainFrame = mainFrame,
        TopBar = topBar,
        SubTitle = titleLbl.SubTitle,
        Title = titleLbl,
        UIScale = uiScale,
        Flags = flags,
    })

    minimizeBtn.Activated:Connect(function() winObj:MinimizeButton() end)
    closeBtn.Activated:Connect(function() winObj:Dialog(closeDialog) end)

    return winObj
end

