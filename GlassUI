local H = {}

function H:Childs(children)
    for i = 1, #children do
        children[i].Parent = self
    end
end

function H:Elements(elements)
    for key, value in pairs(elements) do
        if type(value) == "table" then
            D.SetProperties(G:Create(self, key), value)
        else
            G:Create(self, key, value)
        end
    end
end

function H:ThemeTag(tag)
    local parent = tag.OBJECTS
    tag.OBJECTS = nil
    return (parent or C):add(self, tag)
end

function D:SetProperties(props)
    for key, value in pairs(props) do
        if H[key] then
            H[key](self, value)
        else
            self[key] = value
        end
    end
end

function D:SetValues(...)
    local self_ = self
    for _, value in { ... } do
        local kind = typeof(value)
        if kind == "table" then
            D.SetProperties(self_, value)
        else
            self_[if kind == "string" then "Name" else "Parent"] = value
        end
    end
    return self_
end

local DraggingState

function D:Draggable(handle, scale, clampFn)
    local dragStart, startPos
    local _scale = scale or 0.28
    local lastActivity = 0
    local stopFn

    local function update(input)
        local delta = input.Position - dragStart
        local newPos
        lastActivity = tick()
        if clampFn then
            newPos = clampFn(
                startPos.X.Scale, startPos.X.Offset + delta.X / handle.Scale,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y / handle.Scale
            )
        else
            newPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X / handle.Scale,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y / handle.Scale
            )
        end
        self.Position = self.Position:Lerp(newPos, _scale)
    end

    local function watchdog()
        while DraggingState == self do
            if (tick() - lastActivity) >= 1 then
                stopFn()
                break
            end
            task.wait()
        end
    end

    local pressTypes = {
        [Enum.UserInputType.MouseButton1] = true,
        [Enum.UserInputType.Touch] = true,
    }
    local moveTypes = {
        [Enum.UserInputType.MouseMovement] = true,
        [Enum.UserInputType.Touch] = true,
    }

    u(self.InputBegan, function(input)
        if A == false and DraggingState == nil and pressTypes[input.UserInputType] then
            dragStart = input.Position
            startPos = self.Position
            DraggingState = self
            lastActivity = tick()
            A = true

            local conn
            function stopFn()
                A = false
                DraggingState = nil
                conn:Disconnect()
            end

            task.spawn(watchdog)

            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    stopFn()
                end
            end)
        end
    end)

    u(i.InputChanged, function(input)
        if DraggingState == self and moveTypes[input.UserInputType] then
            update(input)
        end
    end)
end

function D.new(class, ...)
    return D.SetValues(Instance.new(class), ...)
