    function classTab:AddSlider(opts)
        local title = opts[1] or opts.Name or opts.Title
        local desc  = opts.Desc or opts.Description or ""
        local flag      = opts[7] or opts.Flag
        local min       = opts[2] or opts.Min
        local max       = opts[3] or opts.Max
        local increment = opts[4] or opts.Increment
        local default   = opts[5] or opts.Default
        local cb        = F(opts[6] or opts.Callback)

        assert(type(min) == "number", "Tab.AddSlider.Min must be number")
        assert(type(max) == "number", "Tab.AddSlider.Max must be number")
        if increment ~= nil then assert(type(increment) == "number", "Tab.AddSlider.Increment must be number or nil") end
        if default ~= nil then assert(type(default) == "number", "Tab.AddSlider.Default must be number or nil") end

        local renderer = TabRenderers[self]
        local container = TabElements[self].Container
        local opt, titleLbl, descLbl = buildRow(self, title, desc, UDim2.new(0.55, 0, 0, 0))

        if default == nil then default = min end
        if increment == nil then increment = 1 end
        if flag ~= nil and type(Flags[flag]) == "number" then default = Flags[flag] end

        local sliderBtn = E("TextButton", opt, {
            Size = UDim2.new(0.45, 0, 1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            AnchorPoint = Vector2.new(1, 0),
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            Text = "",
        })

        local track = E("Frame", sliderBtn, {
            Size = UDim2.new(1, -20, 0, 6),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ThemeTag = { OBJECTS = renderer, BackgroundColor3 = "Colors.Stroke" },
            Elements = { Corner = UDim.new(1, 0) },
        })

        local fill = E("Frame", track, {
            Size = UDim2.fromScale(0, 1),
            BorderSizePixel = 0,
            ThemeTag = { OBJECTS = renderer, BackgroundColor3 = "Colors.Primary" },
            Elements = { Corner = UDim.new(1, 0) },
        })

        local knob = E("Frame", track, {
            Size = UDim2.new(0, 8, 0, 14),
            BackgroundColor3 = Color3.fromRGB(240, 240, 250),
            Position = UDim2.fromScale(0, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 0.05,
            Elements = { Corner = UDim.new(0, 6) },
        })

        local valueLbl = E("TextLabel", sliderBtn, {
            Size = UDim2.new(0, 50, 0, 14),
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(0, -2, 0.5),
            BackgroundTransparency = 1,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
            ThemeTag = { OBJECTS = renderer, TextColor3 = "Colors.Text.Default", Font = "Font.SliderValue" },
        })

        local valueScale = E("UIScale", valueLbl)

        local slider = ComponentClasses.Slider.new(self, opt, titleLbl, descLbl, cb)
        slider.Min, slider.Max, slider.Increment = min, max, increment

        local function toFraction(v) return (v - min) / (max - min) end
        local function fromFraction(fr) return fr * (max - min) + min end
        local function snap(v) return math.round(v / increment) * increment end

        local function setValue(v, fraction)
            if v == slider.Value then return end
            if flag ~= nil then Flags[flag] = v end
            task.defer(RunCallbacks, cb, v)
            slider.Value = v

            local targetPos  = UDim2.fromScale(fraction, 0.5)
            local targetSize = UDim2.fromScale(fraction, 1)
            valueLbl.Text = tostring(math.floor(v * 1000) / 1000)

            if self.Selected then
                J(knob, "Position", targetPos, 0.2):Play()
                J(fill, "Size", targetSize, 0.2):Play()
            else
                knob.Position = targetPos
                fill.Size = targetSize
            end
        end

        local function setFromValue(v)
            local clamped = clamp(snap(v), min, max)
            setValue(clamped, toFraction(clamped))
        end

        slider.WHEN_VALUE_CHANGED = setFromValue

        local function setFromMouse(absX, absSize)
            local fraction = clamp((Mouse.X - absX) / absSize.X, 0, 1)
            local value = clamp(snap(fromFraction(fraction)), min, max)
            setValue(value, toFraction(value))
        end

        local anim = Random.new()
        setFromValue(default)

        sliderBtn.MouseButton1Down:Connect(function()
            if IS_DRAGGING_GLOBAL then return end
            J(knob, "BackgroundTransparency", 0, 0.2):Play()
            container.ScrollingEnabled = false
            IS_DRAGGING_GLOBAL = true
            local absPos, absSize = track.AbsolutePosition, track.AbsoluteSize
            while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                setFromMouse(absPos, absSize)
                task.wait()
            end
            IS_DRAGGING_GLOBAL = false
            J(knob, "BackgroundTransparency", 0.05, 0.2):Play()
            container.ScrollingEnabled = true
        end)

        valueLbl:GetPropertyChangedSignal("Text"):Connect(function()
            if not self.Selected then return end
            valueScale.Scale = 0.4
            J(valueScale, "Scale", 1.15, 0.12):Play()
            local rot = J(valueLbl, "Rotation", anim:NextNumber(-6, 6), 0.15)
            rot:Play()
            rot.Completed:Wait()
            J(valueScale, "Scale", 1, 0.2):Play()
            J(valueLbl, "Rotation", 0, 0.1):Play()
        end)

        return slider
    end

