    function classWindow:SelectTab(index)
        local tab
        if type(index) == "number" then tab = TabsList[index] end
        if type(index) == "table" and index.IS_A_TAB then tab = index end

        if tab then
            tab:Select()
        elseif not tab then
            assert(type(index) == "number", "Window.SelectTab expects number or tab")
            assert(index > 0 and index == math.floor(index), "Window.SelectTab expects positive integer")
            self.SelectedTab = index
        end
