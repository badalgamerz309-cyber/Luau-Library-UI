        function classWindow:MinimizeButton()
            if (tick() - debounce) < 0 then return false end

            if self.Minimized then
                MinimizeBtn.Image = s.CurrentTheme.Icons.Minimize
                J(MainFrame, "Size", savedSize, 0.3):Play()
            else
                savedSize = MainFrame.Size
                MinimizeBtn.Image = s.CurrentTheme.Icons.Restore
                J(MainFrame, "Size", UDim2.fromOffset(MainFrame.Size.X.Offset, TopBar.Size.Y.Offset), 0.3):Play()
            end

            for _, r in Resizers do r.Visible = self.Minimized end

            self.Minimized = not self.Minimized
            debounce = tick() + 0.5

            -- Floating icon handling
            if self.Minimized then
                if not self._floatIcon then
                    self._floatIcon = classMinimizer.CreateMobileMinimizer(self, {
                        Icon = self._floatIconImage,
                    })
                    u(self._floatIcon.Activated, function()
                        if classWindow.MinimizeButton then classWindow.MinimizeButton(self) end
                    end)
                end
                self._floatIcon.Visible = true
