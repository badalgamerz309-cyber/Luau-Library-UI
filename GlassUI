            end
            tag.BackgroundColor3 = color
            J(option, "BackgroundColor3", w(s.CurrentTheme, color), 0.2):Play()
        end

        u(option.MouseLeave, function() hover("Colors.Buttons.Default", false) end)
        u(option.MouseEnter, function() hover("Colors.Buttons.Holding", true) end)

        u(descLbl:GetPropertyChangedSignal"Text", function()
            local hasText = #descLbl.Text > 0
