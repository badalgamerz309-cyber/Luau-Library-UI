    -- ---------------------------------------------------------
    function classTab:AddToggle(opts)
        local title, desc = unpack((function(t) return t end)({ opts[1] or opts.Name or opts.Title, opts.Desc or opts.Description or "" }))
        local flag = opts[4] or opts.Flag
        local default = opts[2] or opts.Default or false
        local cb = F(opts[3] or opts.Callback)

        assert(type(title) == "string", "Tab.AddToggle.Title must be string")
        assert(type(default) == "boolean", "Tab.AddToggle.Default must be boolean")

        local renderer = TabRenderers[self]
        local opt, titleLbl, descLbl = buildRow(self, title, desc, UDim2.new(1, -42, 0, 0))

        -- Toggle track
        local track = E("Frame", opt, {
            Size = UDim2.new(0, 40, 0, 20),
            Position = UDim2.new(1, -10, 0.5),
            AnchorPoint = Vector2.new(1, 0.5),
            Elements = { Corner = UDim.new(1, 0) },
            ThemeTag = {
                OBJECTS = renderer,
                BackgroundColor3 = "Colors.Stroke",
            },
        })

        local inner = E("Frame", track, {
            BackgroundTransparency = 1,
            Size = UDim2.new(0.85, 0, 0.85, 0),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
        })

        local knobTag = {
            OBJECTS = renderer,
            BackgroundColor3 = "Colors.OnPrimary",
        }

        local knob = E("Frame", inner, {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, 0, 0.5),
            AnchorPoint = Vector2.new(0, 0.5),
            Elements = { Corner = UDim.new(1, 0) },
            ThemeTag = knobTag,
        })

        local lastTick = tick()
        local debounce = 0.2
        local tweens = {}

        local function playBatch(list)
            tweens = {}
            for i = 1, #list do
                list[i]:Play()
                tweens[i] = list[i]
            end
        end

        local function cancelBatch()
            for i = #tweens, 1, -1 do
                local t = tweens[i]
                if t.PlaybackState == Enum.PlaybackState.Playing then t:Cancel() end
                tweens[i] = nil
            end
        end

        local function apply(value)
            if flag ~= nil then Flags[flag] = value and 0 or 1 end
            G(cb, value)

            local targetPos = UDim2.new(value and 1 or 0, 0, 0.5, 0)
            local targetAnchor = Vector2.new(value and 1 or 0, 0.5)
            local targetColor = value and "Colors.Primary" or "Colors.OnPrimary"
            local color3 = w(s.CurrentTheme, targetColor)

            knobTag.BackgroundColor3 = targetColor

            if self.Selected and (tick() - lastTick) >= debounce then
                playBatch({
                    J(knob, "Position", targetPos, 0.25),
                    J(knob, "AnchorPoint", targetAnchor, 0.25),
                    J(knob, "BackgroundColor3", color3, 0.25),
                })
            else
                cancelBatch()
                knob.Position = targetPos
                knob.AnchorPoint = targetAnchor
                knob.BackgroundColor3 = color3
            end

            lastTick = tick()
        end

        local toggle = ak.Toggle.new(self, opt, titleLbl, descLbl, apply, cb)
        toggle:SetValue(default)

        local lastClick = 0
        u(opt.Activated, function()
            if (tick() - lastClick) >= debounce then
                lastClick = tick()
                toggle:SetValue(not toggle.Value)
            end
        end)

        return toggle
    end

