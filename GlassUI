local v = {}
v.__index = v

local w = function(root, path)
    for segment in path:gmatch"[^%.]+" do
        root = root[segment]
    end
    return root
end

local x = function(obj, prop, path, theme)
    if not theme then theme = s.CurrentTheme end
    obj[prop] = w(theme, if type(path) == "function" then path() else path)
end

local y = function(theme, obj, tag)
    for prop, path in tag do
        x(obj, prop, path, theme)
    end
end

local z = function(path, content)
    if d then
        local parts = path:split"/"
        parts[#parts] = nil
        local dir = table.concat(parts, "/")
        if dir ~= "" and (isfolder == nil or not isfolder(dir)) then
            d(dir)
        end
    end
    e(path, content)
end

local A = false

local B = {
    MAX_SCALE = 1.6,
    MIN_SCALE = 0.6,
    TEXTBOX = { PLACEHOLDER_TEXT = "Input" },
}

function v:add(desc, path)
    self.Descendants[path] = desc
    if self.IS_RENDERING then
        y(s.CurrentTheme, desc, path)
    end
end

function v:update()
    if self.IS_RENDERING and not self.UPDATED_OBJECTS then
        local theme = s.CurrentTheme
        self.UPDATED_OBJECTS = true
        for path, desc in self.Descendants do
            local kind = typeof(desc)
            if kind == "table" then
                desc:update()
                continue
            end
            y(theme, desc, path)
        end
    end
end

function v:destroy()
    local idx = self.Parent and table.find(self.Parent.Descendants, self)
    if idx then table.remove(self.Parent.Descendants, idx) end
    table.clear(self.Descendants)
    setmetatable(self, nil)
end

function v:changeRendering(state)
    if self.IS_RENDERING ~= state then
        self.IS_RENDERING = state
        self.UPDATED_OBJECTS = false
    end
end

function v:new()
    local child = setmetatable({
        IS_RENDERING = true,
        UPDATED_OBJECTS = false,
        Descendants = {},
        Parent = self.Descendants ~= nil and self or nil,
    }, v)
    if self.Descendants then
        table.insert(self.Descendants, child)
    end
    return child
end

