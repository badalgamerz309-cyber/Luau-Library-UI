-- Tween shortcut
local J = function(inst, prop, target, duration, easing, ...)
    local info = TweenInfo.new(duration, easing or Enum.EasingStyle.Quint, ...)
    return TweenService:Create(inst, info, { [prop] = target })
end

-- Set builder
local K = function(list)
    local set = {}
    for i = 1, #list do rawset(set, list[i], true) end
    return set
end

-- Chars to strip during search
local STRIP_CHARS = K(string.split("\n\t,_:;()[]#&=!. \"'*^<>$"))

local M = function(str)
    return string.gsub(str:lower(), ".", function(ch)
        return STRIP_CHARS[ch] and "" or ch
    end)
end

-- Thousands separator
local N = function(num)
    local str, out, count = tostring(num), "", 0
    for i = #str, 1, -1 do
        out = str:sub(i, i) .. out
        count += 1
        if i > 1 and count % 3 == 0 then out = "," .. out end
    end
    return out
end

-- rbxassetid:// prefix check
local O = function(str)
    local prefix = "rbxassetid://"
    return str:sub(1, #prefix) == prefix
end

-- UI scale from a 1.0 reference
local P = function(scale) return (ViewportSize.Y / 450) * scale end

-- Human-readable time
local Q = function(seconds)
    local mins  = math.floor(seconds / 60)
    local hours = math.floor(seconds / 60 / 60)
    seconds = math.floor((seconds - (mins * 60)) * 10) / 10
    mins = mins - (hours * 60)
    if hours > 0 then return ("%dh %dm %ds"):format(hours, mins, math.floor(seconds))
    elseif mins > 0 then return ("%dm %ds"):format(mins, math.floor(seconds))
    else return tostring(seconds) end
end

-- Clamp helper
local clamp = math.clamp

