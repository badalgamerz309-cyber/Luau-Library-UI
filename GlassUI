-- //===========================================================
-- // HELPERS
-- //===========================================================
local function create(class, props)
    local inst = Instance.new(class)
    local parent = nil
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function tween(inst, props, info)
    local t = TweenService:Create(inst, info or Theme.TweenNormal, props)
    t:Play()
    return t
end

local function corner(inst, radius)
    return create("UICorner", { CornerRadius = radius or Theme.Corner, Parent = inst })
end

local function stroke(inst, color, thick, trans)
    return create("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thick or 1,
        Transparency = trans or 0.4,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = inst,
    })
end

local function gradient(inst, seq, rot)
    return create("UIGradient", {
        Color = seq or Theme.BackgroundGradient,
        Rotation = rot or Theme.GradientRotation,
        Parent = inst,
    })
end

local function padding(inst, t, b, l, r)
    return create("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
        Parent = inst,
    })
end

local function listLayout(inst, pad, fill)
    return create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, pad or 5),
        FillDirection = fill or Enum.FillDirection.Vertical,
        Parent = inst,
    })
end

-- Draggable with lerp (like redz D:Draggable)
local function makeDraggable(handle, target, scale, clampFn)
    scale = scale or 0.28
    local dragging, dragStart, startPos = false, nil, nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        local newPos = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        if clampFn then
            local sX, oX, sY, oY = clampFn(newPos.X.Scale, newPos.X.Offset, newPos.Y.Scale, newPos.Y.Offset)
            if sX then newPos = UDim2.new(sX, oX, sY or newPos.Y.Scale, oY or newPos.Y.Offset) end
        end
        target.Position = target.Position:Lerp(newPos, scale)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- //===========================================================
-- // LUCIDE
-- //===========================================================
local Lucide = nil
function GlassUI:SetLucide(module)
    Lucide = module
end

local function lucideIcon(name, size, color)
    size = size or 16
    color = color or Theme.Icons
    local img = create("ImageLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size, size),
        ImageColor3 = color,
        Image = "",
    })
    if Lucide and type(Lucide) == "table" then
        local ok, asset = pcall(function()
            if Lucide.GetAsset then return Lucide.GetAsset(name, size) end
            return nil
        end)
        if ok and asset then
            img.Image = type(asset) == "table" and (asset.Image or asset.Icon or "") or tostring(asset)
        end
    end
    return img
end
GlassUI.Icon = lucideIcon

-- //===========================================================
-- // NOTIFICATIONS (bottom -> top animation)
-- //===========================================================
local notifGui = create("ScreenGui", {
    Name = "GlassUI_Notify",
    ResetOnSpawn = false,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    IgnoreGuiInset = true,
    Parent = GUI_PARENT,
})

local notifHolder = create("Frame", {
    Name = "Holder",
    Size = UDim2.new(0, 320, 1, -40),
    Position = UDim2.new(1, -20, 1, -20),
    AnchorPoint = Vector2.new(1, 1),
    BackgroundTransparency = 1,
    Parent = notifGui,
})
listLayout(notifHolder, 10)
notifHolder.UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom

local typeColors = {
    info    = Theme.Primary,
    success = Theme.Success,
    warning = Theme.Warning,
    error   = Theme.Error,
}

function GlassUI:Notify(opts)
    opts = opts or {}
    local title    = opts.Title or opts[1]
    local message  = opts.Message or opts.Content or opts[2] or ""
    local duration = opts.Duration or 4
    local kind     = opts.Type or "info"
    local accent   = typeColors[kind] or Theme.Primary

    local card = create("Frame", {
        Name = "Notification",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Color3.fromRGB(28, 28, 34),
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = notifHolder,
    })
    corner(card, Theme.Corner)
    stroke(card, accent, 1, 0.7)
    gradient(card, Theme.BackgroundGradient, 135)
    padding(card, 12, 12, 14, 14)

    -- Accent bar
    local bar = create("Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 0, 0, 8),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(bar, UDim.new(1, 0))

    if title then
        create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -14, 0, 16),
            Position = UDim2.new(0, 14, 0, 0),
            Font = Theme.FontBold,
            TextSize = 13,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = title,
            Parent = card,
        })
    end

    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -14, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(0, 14, 0, title and 20 or 0),
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Text = message,
        Parent = card,
    })

    -- Slide bottom -> up animation
    card.Position = UDim2.new(0, 0, 0, 90)
    card.BackgroundTransparency = 1
    tween(card, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.08 }, Theme.TweenSmooth)

    task.delay(duration, function()
        if not card.Parent then return end
        tween(card, { Position = UDim2.new(0, 0, 0, -90), BackgroundTransparency = 1 }, Theme.TweenNormal)
        task.wait(0.3)
        card:Destroy()
    end)

    return card
end

