        Parent = header,
    })

    local arrow = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -20, 0.5, -8),
        Font = Theme.FontBold,
        TextSize = 10,
        TextColor3 = Theme.TextDim,
        Text = "▼",
        Parent = header,
    })

    local dropdown = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 36),
        BackgroundColor3 = Color3.fromRGB(30, 30, 36),
        BackgroundTransparency = 0.05,
        ClipsDescendants = true,
        Visible = false,
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = container,
    })
    corner(dropdown, Theme.CornerSmall)
    stroke(dropdown, Theme.Stroke, 1, 0.5)

    local list = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = dropdown,
    })
    listLayout(list, 2)
    padding(list, 6, 6, 6, 6)

    local function refreshOptions()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for i, opt in ipairs(options) do
            local optBtn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 26),
                BackgroundColor3 = Theme.ButtonDefault,
                BackgroundTransparency = 1,
                Text = tostring(opt),
                Font = Theme.Font,
                TextSize = 12,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                Parent = list,
            })
            corner(optBtn, Theme.CornerSmall)
            padding(optBtn, 0, 0, 10, 10)

            optBtn.MouseEnter:Connect(function()
                tween(optBtn, { BackgroundTransparency = 0.85 }, Theme.TweenFast)
            end)
            optBtn.MouseLeave:Connect(function()
                tween(optBtn, { BackgroundTransparency = 1 }, Theme.TweenFast)
            end)
            optBtn.MouseButton1Click:Connect(function()
                selected = opt
                selLbl.Text = tostring(opt)
                tween(dropdown, { Size = UDim2.new(1, 0, 0, 0) }, Theme.TweenNormal)
                task.wait(0.2)
                dropdown.Visible = false
                opened = false
                if callback then task.spawn(callback, opt) end
            end)
        end
    end
    refreshOptions()

    header.MouseButton1Click:Connect(function()
        opened = not opened
        if opened then
            dropdown.Visible = true
            local target = #options * 28 + 12
            tween(dropdown, { Size = UDim2.new(1, 0, 0, target) }, Theme.TweenSmooth)
            tween(arrow, { Rotation = 180 }, Theme.TweenFast)
        else
            tween(dropdown, { Size = UDim2.new(1, 0, 0, 0) }, Theme.TweenNormal)
            tween(arrow, { Rotation = 0 }, Theme.TweenFast)
            task.wait(0.2)
            dropdown.Visible = false
        end
    end)

    return setmetatable({
        Set = function(v)
            selected = v
            selLbl.Text = tostring(v)
            if callback then task.spawn(callback, v) end
        end,
        Get = function() return selected end,
        SetOptions = function(opts2)
            options = opts2
            refreshOptions()
        end,
        DestroyElement = container,
        VisibleElement = container,
        TitleLabel = selLbl,
    }, Option)
end

