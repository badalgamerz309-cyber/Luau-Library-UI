                OBJECTS = renderer,
                BackgroundColor3 = "Colors.Stroke",
            },
        })

        local check = E("TextLabel", box, {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            TextSize = 12,
            Text = "✓",
            TextTransparency = 1,
            ThemeTag = {
                OBJECTS = renderer,
                TextColor3 = "Colors.Text.Default",
