        defaultNotifIcon = icon
    end

    function classWindow:Notify(opts)
        if type(opts) ~= "table" then opts = {} end

        local title    = opts[1] or opts.Name or opts.Title
        local content  = opts[2] or opts.Content or opts.Description
        local icon     = opts[3] or opts.Icon or opts.Image
        local duration = opts[4] or opts.Duration or opts.Time

        if self.NOTIFICATION_GROUP then
            duration = duration or self.Duration
            content  = content  or self.Content
            title    = title    or self.Title
            icon     = icon     or self.Icon
        end

        assert(type(title) == "string", "Window.Notify.Title must be string")
        assert(type(content) == "string", "Window.Notify.Content must be string")
        assert(icon == nil or type(icon) == "string", "Window.Notify.Icon must be string or nil")

        if duration ~= nil and type(duration) ~= "number" then
            error("Window.Notify.Time must be number or nil", 2)
        elseif duration == nil then
            duration = 5
        end

        -- Delegate to the shared notifier (bottom→top)
        return buildNotification(self, {
            Title = title, Content = content,
            Icon = icon, Duration = duration,
        })
    end

    function classWindow:NewNotifyGroup(opts)
        local title    = opts[1] or opts.Name or opts.Title
        local content  = opts[2] or opts.Content
        local icon     = opts[3] or opts.Icon or opts.Image
        local duration = opts[4] or opts.Duration or opts.Time

        if title    ~= nil then assert(type(title) == "string", "NewNotifyGroup.Title must be string") end
        if content  ~= nil then assert(type(content) == "string", "NewNotifyGroup.Content must be string") end
        if icon     ~= nil then assert(type(icon) == "string", "NewNotifyGroup.Icon must be string") end
        if duration ~= nil then assert(type(duration) == "number", "NewNotifyGroup.Duration must be number") end

        return {
            NOTIFICATION_GROUP = true,
            Notify = classWindow.Notify,
            Duration = duration,
            Content = content,
            Title = title,
            Icon = icon,
        }
    end

