            },
        })

        local function apply(value)
            J(box, "BackgroundColor3",
                w(s.CurrentTheme, value and "Colors.Primary" or "Colors.Stroke"), 0.15):Play()
            J(check, "TextTransparency", value and 0 or 1, 0.15):Play()
            G(cb, value)
        end

        local checkbox = ak.Checkbox.new(self, opt, titleLbl, apply, cb)
        checkbox:SetValue(default)

        u(opt.Activated, function()
            checkbox:SetValue(not checkbox.Value)
        end)

        return checkbox
    end

