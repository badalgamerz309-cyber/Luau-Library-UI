local function buildNotification(opts)
    local title    = opts.Title or opts.Name or opts[1]
    local content  = opts.Content or opts.Description or opts[2] or ""
    local icon     = opts.Icon or opts.Image or opts[3]
    local duration = opts.Duration or opts.Time or opts[4] or 4
    local kind     = opts.Type or "info"

    local palette = Library.CurrentTheme
    local accent = ({
        info    = palette.Colors.Primary,
        success = palette.Colors.Success,
        warning = palette.Colors.Warning,
        error   = palette.Colors.Error,
    })[kind] or palette.Colors.Primary

    local root = E("Frame", "Notification", notifContainer, {
        Size = UDim2.new(0.95, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    })

    local bg = E("TextButton", root, {
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.fromScale(1, 1),
        AutoButtonColor = false,
        Text = "",
        ThemeTag = { BackgroundTransparency = "BackgroundTransparency" },
        Elements = {
            Corner = UDim.new(0, 12),
            Gradient = { Rotation = 135, ThemeTag = { Color = "Colors.Background" } },
            Stroke = { Thickness = 1, ThemeTag = { Color = "Colors.Primary" } },
            Padding = {
                PaddingLeft = UDim.new(0, 46),
                PaddingTop = UDim.new(0, 11),
                PaddingBottom = UDim.new(0, 11),
                PaddingRight = UDim.new(0, 12),
            },
            ListLayout = { Padding = UDim.new(0, 3) },
        },
    })

    E("Frame", "Accent", bg, {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 0, 0, 8),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Elements = { Corner = UDim.new(1, 0) },
    })

    E("TextLabel", "Title", bg, {
        Size = UDim2.new(1, 0, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        TextSize = 13,
        Text = title or "",
        ThemeTag = { TextColor3 = "Colors.Text.Default", Font = "Font.Bold" },
    })

    E("TextLabel", "Content", bg, {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        BackgroundTransparency = 1,
        TextSize = 11,
        Text = content,
        ThemeTag = { TextColor3 = "Colors.Text.Dark", Font = "Font.Normal" },
    })

    local iconImg = E("ImageLabel", "Icon", bg, {
        Size = UDim2.fromOffset(24, 24),
        Position = UDim2.new(0, 12, 0, 10),
        BackgroundTransparency = 1,
        ThemeTag = { ImageColor3 = "Colors.Icons" },
    })
    local resolved = lucideAsset(icon or defaultNotifIcon, 24) or (icon or defaultNotifIcon)
    if resolved and resolved ~= "" then
        iconImg.Image = resolved
    else
        iconImg.Visible = false
        bg.UIPadding.PaddingLeft = UDim.new(0, 14)
    end

    local timerLbl = E("TextLabel", "Timer", bg, {
        Size = UDim2.new(0, 40, 0, 14),
        Position = UDim2.new(1, -6, 0, 6),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        TextSize = 10,
        ThemeTag = { TextColor3 = "Colors.Text.Darker", Font = "Font.Normal" },
    })

    -- Slide in from below
    bg.Position = UDim2.new(0, 0, 1, 60)
    root.BackgroundTransparency = 1
    J(bg, "Position", UDim2.new(0, 0, 0, 0), 0.4, Enum.EasingStyle.Quint):Play()

    local hovered = false
    local function tickTimer()
        local remaining = duration
        while remaining > 0 do
            if not hovered then
                remaining -= task.wait()
                timerLbl.Text = Q(math.max(remaining, 0))
            else
                task.wait()
            end
            if not bg.Parent then return end
        end
        -- Slide out to top
        local out = J(bg, "Position", UDim2.new(0, 0, 0, -60), 0.35, Enum.EasingStyle.Quint)
        out:Play()
        out.Completed:Wait()
        if root.Parent then root:Destroy() end
    end

    bg.MouseEnter:Connect(function() hovered = true end)
    bg.MouseLeave:Connect(function() hovered = false end)
    task.spawn(tickTimer)

    return root
end

