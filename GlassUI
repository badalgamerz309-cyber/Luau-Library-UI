    -- ========================================================================================
    -- § 12.21 Tab lifecycle
    -- ========================================================================================
    function classTab:Destroy()
        assert(type(self) == "table" and self.IS_A_TAB, "Tab.Destroy requires a tab")
        if self.IS_DESTROYED then return end
        local idx = table.find(TabsList, self)
        assert(idx, "Tab.Destroy failed")
        table.remove(TabsList, idx)
        for _, el in pairs(TabElements[self]) do el:Destroy() end
        TabRenderers[self]:destroy()
        TabElements[self] = nil
        TabRenderers[self] = nil
        setmetatable(self, nil)
    end

    function classTab:SetVisible(v)
        assert(type(v) == "boolean", "Tab.SetVisible expects boolean")
        for _, el in pairs(TabElements[self]) do el.Visible = v end
    end

    function classTab:Select()
        if ActiveTab == self then return end
        if ActiveTab then TabSelectors[ActiveTab].Unselect() end
        ActiveTab = self
        TabSelectors[ActiveTab].Select()
    end

