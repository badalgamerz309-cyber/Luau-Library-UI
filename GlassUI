            if input.KeyCode == minimizer.KeyCode then
                classWindow.MinimizeButton(self)
            end
        end)
        return minimizer
    end

    function classWindow:Dialog(opts)
        if self.Minimized then
            while not classWindow.MinimizeButton(self) do task.wait() end
        end
        if CurrentDialog then CurrentDialog:Close(true) end

        local title   = opts.Title or opts.Name
        local content = opts.Content or opts.Description
        local options = opts.Options

        assert(type(title) == "string", "Window.Dialog.Title must be string")
        assert(type(content) == "string", "Window.Dialog.Content must be string")
        assert(type(options) == "table" and #options > 0, "Window.Dialog.Options must be non-empty table")

        local function open()
            local template = OutBox.Template
            local descLbl = template.Description
            local titleLbl = template.Title
            local originalSize = template:GetAttribute"OriginalSize"
            local grownSize = UDim2.new(
                originalSize.X.Scale * 1.2, originalSize.X.Offset,
                originalSize.Y.Scale * 1.2, originalSize.Y.Offset
            )
            template.Size = grownSize
            OutBox.Parent = MainFrame
            descLbl.Text = content
            titleLbl.Text = title
            J(template, "Size", originalSize, 0.3):Play()

            local dlg = ak.Dialog.new(descLbl, titleLbl)
            dlg.NEW_SIZE = grownSize
            dlg.TEMPLATE = template

            for _, child in template.Options:GetChildren() do
                if child:IsA"GuiObject" then child:Destroy() end
            end

            for i = #options, 1, -1 do
                dlg:NewOption(options[i])
            end
            return dlg
        end

        CurrentDialog = open()
        return CurrentDialog
    end

