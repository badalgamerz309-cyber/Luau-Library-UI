    function classTab:AddSlider(opts)
        local title, desc = opts[1] or opts.Name or opts.Title, opts.Desc or opts.Description or ""
        local flag      = opts[7] or opts.Flag
        local min       = opts[2] or opts.Min
        local max       = opts[3] or opts.Max
        local increment = opts[4] or opts.Increment
        local default   = opts[5] or opts.Default
        local cb        = F(opts[6] or opts.Callback)

        assert(type(min) == "number", "Tab.AddSlider.Min must be number")
        assert(type(max) == "number", "Tab.AddSlider.Max must be number")
        if increment ~= nil then
            assert(type(increment) == "number", "Tab.AddSlider.Increment must be number or nil")
        end
        if default ~= nil then
            assert(type(default) == "number", "Tab.AddSlider.Default must be number or nil")
        end

        local renderer = TabRenderers[self]
        local container = TabElements[self].Container
        local opt, titleLbl, descLbl = buildRow(self, title, desc, UDim2.new(0.55, 0, 0, 0))

        if default == nil then default = min end
        if increment == nil then increment = 1 end

        if flag ~= nil and type(Flags[flag]) == "number" then
            default = Flags[flag]
        end

        -- Slider region (right side of the row)
        local sliderBtn = E("TextButton", opt, {
            Size = UDim2.new(0.45, 0, 1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            AnchorPoint = Vector2.new(1, 0),
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            Text = "",
        })

        local track = E("Frame", sliderBtn, {
            Size = UDim2.new(1, -20, 0, 6),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ThemeTag = {
                OBJECTS = renderer,
                BackgroundColor3 = "Colors.Stroke",
            },
            Elements = { Corner = UDim.new(1, 0) },
        })

        local fill = E("Frame", track, {
            Size = UDim2.fromScale(0, 1),
            BorderSizePixel = 0,
            ThemeTag = {
                OBJECTS = renderer,
                BackgroundColor3 = "Colors.Primary",
            },
            Elements = { Corner = UDim.new(1, 0) },
        })

        local knob = E("Frame", track, {
            Size = UDim2.new(0, 8, 0, 14),
            BackgroundColor3 = Color3.fromRGB(240, 240, 250),
            Position = UDim2.fromScale(0, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 0.05,
            Elements = { Corner = UDim.new(0, 6) },
        })

        local valueLbl = E("TextLabel", sliderBtn, {
            Size = UDim2.new(0, 50, 0, 14),
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(0, -2, 0.5),
            BackgroundTransparency = 1,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
            ThemeTag = {
                OBJECTS = renderer,
                TextColor3 = "Colors.Text.Default",
                Font = "Font.SliderValue",
            },
        })

        local valueScale = E("UIScale", valueLbl)

        local slider = ak.Slider.new(self, opt, titleLbl, descLbl, cb)
        slider.Min = min
        slider.Max = max
        slider.Increment = increment

        local function toFraction(v) return (v - min) / (max - min) end
        local function fromFraction(f) return f * (max - min) + min end
        local function snap(v) return math.round(v / increment) * increment end

        local function setValue(v, fraction)
            if v == slider.Value then return end
            if flag ~= nil then Flags[flag] = v end
            task.defer(G, cb, v)
            slider.Value = v

            local targetPos = UDim2.fromScale(fraction, 0.5)
            local targetSize = UDim2.fromScale(fraction, 1)

            valueLbl.Text = tostring(math.floor(v * 1000) / 1000)

            if self.Selected then
                J(knob, "Position", targetPos, 0.2):Play()
                J(fill, "Size", targetSize, 0.2):Play()
            else
                knob.Position = targetPos
                fill.Size = targetSize
            end
        end

        local function setFromValue(v)
            local clamped = math.clamp(snap(v), min, max)
            setValue(clamped, toFraction(clamped))
        end

        slider.WHEN_VALUE_CHANGED = setFromValue

        local function setFromMouse(absX, absSize)
            local fraction = math.clamp((p.X - absX) / absSize.X, 0, 1)
            local value = snap(fromFraction(fraction))
            setValue(math.clamp(value, min, max), toFraction(math.clamp(value, min, max)))
        end

        local anim = Random.new()
        setFromValue(default)

        u(sliderBtn.MouseButton1Down, function()
            if A ~= false then return end

            J(knob, "BackgroundTransparency", 0, 0.2):Play()
            container.ScrollingEnabled = false
            A = true

            local absPos, absSize = track.AbsolutePosition, track.AbsoluteSize
            while i:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                setFromMouse(absPos, absSize)
                task.wait()
            end

            A = false
            J(knob, "BackgroundTransparency", 0.05, 0.2):Play()
            container.ScrollingEnabled = true
        end)

        u(valueLbl:GetPropertyChangedSignal"Text", function()
            if not self.Selected then return end
            valueScale.Scale = 0.4
            J(valueScale, "Scale", 1.15, 0.12):Play()
            local rot = J(valueLbl, "Rotation", anim:NextNumber(-6, 6), 0.15)
            rot:Play()
            rot.Completed:Wait()
            J(valueScale, "Scale", 1, 0.2):Play()
            J(valueLbl, "Rotation", 0, 0.1):Play()
        end)

        return slider
    end

    -- ---------------------------------------------------------
    -- DROPDOWN
    -- ---------------------------------------------------------
    function classTab:AddDropdown(opts)
        local title, desc = opts[1] or opts.Name or opts.Title, opts.Desc or opts.Description or ""
        local flag       = opts[5] or opts.Flag
        local list       = opts[2] or opts.Options
        local default    = opts[3] or opts.Default
        local cb         = F(opts[4] or opts.Callback)
        local multiSelect= opts.MultiSelect

        if default ~= nil and type(default) ~= "table" and type(default) ~= "string" then
            error("Tab.AddDropdown.Default must be string, table, or nil", 2)
        end
        if list ~= nil and type(list) ~= "table" then
            error("Tab.AddDropdown.Options must be table or nil", 2)
        end
        if multiSelect ~= nil and type(multiSelect) ~= "boolean" then
            error("Tab.AddDropdown.MultiSelect must be boolean or nil", 2)
        end

        if flag and type(Flags[flag]) == (multiSelect and "table" or "string") then
            default = Flags[flag]
        end

        local renderer = TabRenderers[self]
        local opt, titleLbl, descLbl = buildRow(self, title, desc, UDim2.new(1, -160, 0, 0))

        local box = E("Frame", opt, {
            Size = UDim2.new(0, 150, 0, 20),
            Position = UDim2.new(1, -10, 0.5),
            AnchorPoint = Vector2.new(1, 0.5),
            Elements = { Corner = s.CurrentTheme.CornerRadiusButton },
            ThemeTag = {
                OBJECTS = renderer,
                BackgroundColor3 = "Colors.Stroke",
            },
        })

        local displayLbl = E("TextLabel", box, {
            Size = UDim2.new(0.85, 0, 0.85, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            BackgroundTransparency = 1,
            TextScaled = true,
            Text = "...",
            ThemeTag = {
                OBJECTS = renderer,
                TextColor3 = "Colors.Text.Default",
                Font = "Font.Bold",
            },
        })

        local arrowTag = {
            OBJECTS = renderer,
            Image = "Icons.Dropdown.Open",
            ImageColor3 = "Colors.Icons",
        }
        local arrow = E("ImageLabel", box, {
            Size = UDim2.new(0, 15, 0, 15),
            Position = UDim2.new(1, -4, 0.5),
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundTransparency = 1,
            ThemeTag = arrowTag,
        })

        local dropdown = ak.Dropdown.new(self, opt, titleLbl, descLbl, cb)

        local selected, opened, openedOnce
        local optionsList, optionEnabled, optionsMap, optionInstances = {}, {}, {}, {}
        local searchRenderer

        dropdown.DROPDOWN_OPTIONS = optionsList
        dropdown.Opened = false

        -- Dropdown popup
        local function buildPopup()
            local popup = E("TextButton", "PopupOverlay", I, {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text = "",
                Active = true,
            })

            local panel = E("Frame", "Dropdown", popup, {
                Size = UDim2.fromOffset(160, 0),
                Position = UDim2.fromOffset(50, 50),
                Elements = {
                    Corner = s.CurrentTheme.CornerRadiusSmall,
                    Stroke = {
                        Thickness = 1,
                        ThemeTag = { Color = "Colors.Primary" },
                    },
                    Gradient = {
                        Rotation = s.CurrentTheme.GradientRotation,
                        ThemeTag = { Color = "Colors.Background" },
                    },
                },
                Active = true,
                ThemeTag = {
                    BackgroundTransparency = "BackgroundTransparency",
                },
            })

            local searchWrap = E("TextButton", "Search", panel, {
                Position = UDim2.new(1, 5, 0, 5),
                Size = UDim2.new(0, 25, 0, 25),
                AutomaticSize = Enum.AutomaticSize.X,
                Active = true,
                Text = "",
                Elements = {
                    Corner = s.CurrentTheme.CornerRadiusSmall,
                    Stroke = {
                        Thickness = 1,
                        ThemeTag = { Color = "Colors.Stroke" },
                    },
                    Padding = {
                        PaddingLeft = UDim.new(0, 4),
                        PaddingRight = UDim.new(0, 4),
                    },
                    ListLayout = {
                        Padding = UDim.new(0, 4),
                        FillDirection = Enum.FillDirection.Horizontal,
                    },
                },
                ThemeTag = {
                    BackgroundTransparency = "BackgroundTransparency",
                },
            })

            local searchBox = E("TextBox", "SearchBox", searchWrap, {
                Size = UDim2.new(0, 0, 1, 0),
                Visible = false,
                PlaceholderText = "Search...",
                ClearTextOnFocus = false,
                Text = "",
                Elements = { Corner = s.CurrentTheme.CornerRadiusSmall },
                ThemeTag = {
                    BackgroundColor3 = "Colors.Stroke",
                    TextColor3 = "Colors.Text.Default",
                    Font = "Font.ExtraBold",
                },
            })

            local searchIcon = E("ImageLabel", "SearchIcon", searchWrap, {
                Size = UDim2.new(1, 0, 1, 0),
                SizeConstraint = Enum.SizeConstraint.RelativeYY,
                Position = UDim2.fromScale(0.5, 0.5),
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundTransparency = 1,
                ThemeTag = {
                    ImageColor3 = "Colors.Icons",
                    Image = "Icons.Search",
                },
            })

            local scroll = E("ScrollingFrame", "Options", panel, {
                Size = UDim2.new(1, -6, 1, -6),
                Position = UDim2.fromScale(0.5, 0.5),
                AnchorPoint = Vector2.new(0.5, 0.5),
                ScrollBarThickness = 3,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                CanvasSize = UDim2.new(),
                ScrollingDirection = Enum.ScrollingDirection.Y,
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                Active = true,
                ThemeTag = {
                    ScrollBarImageColor3 = "Colors.ScrollBar",
                    ScrollBarImageTransparency = 0.3,
                },
                Elements = {
                    Padding = {
                        PaddingLeft = UDim.new(0, 6),
                        PaddingRight = UDim.new(0, 6),
                        PaddingTop = UDim.new(0, 6),
                        PaddingBottom = UDim.new(0, 6),
                    },
                    ListLayout = { Padding = UDim.new(0, 3) },
                },
            })

            return {
                root = popup, panel = panel, scroll = scroll,
                searchWrap = searchWrap, searchBox = searchBox,
                searchIcon = searchIcon,
            }
        end

        searchRenderer = buildPopup()

        local popupRoot, popupPanel, popupScroll = searchRenderer.root, searchRenderer.panel, searchRenderer.scroll
        local popupSearch, popupSearchBox, popupSearchIcon = searchRenderer.searchWrap, searchRenderer.searchBox, searchRenderer.searchIcon

        popupRoot.Parent = nil

        local PANEL_WIDTH = 160
        local ROW_HEIGHT = 25
        local MAX_ROWS = 12

        local function rowCountFor(n)
            local mainFrame = TabElements[self].Container
            local scale = UIScale.Scale
            local availableY = I.AbsoluteSize.Y / scale
            return math.min((ROW_HEIGHT * math.max(n, 0.5)) + 10, (ROW_HEIGHT * MAX_ROWS) + 10, availableY / 1.75)
        end

        local function isMouseOverPanel()
            local p0 = popupPanel.AbsolutePosition
            local p1 = popupPanel.AbsoluteSize
            local m = Vector2.new(p.X, p.Y)
            return m.X >= p0.X and m.X <= (p0.X + p1.X) and m.Y >= p0.Y and m.Y <= (p0.Y + p1.Y)
        end

        local function positionPopup(rowCount)
            local hostAbs, hostSize = box.AbsolutePosition, box.AbsoluteSize
            local mainSize = MainFrame.AbsoluteSize
            local scale = UIScale.Scale
            local popupH = rowCountFor(rowCount)

            local mainW = mainSize.X / scale
            local mainH = mainSize.Y / scale
            local hostX = hostAbs.X / scale
            local hostY = hostAbs.Y / scale
            local hostW = hostSize.X / scale
            local hostH = hostSize.Y / scale

            local centerY = hostY + (hostH / 2)
            local topY = centerY - (popupH / 2)
            local margin = 5
            local maxY = mainH - popupH - margin
            local finalY = math.clamp(topY, margin, maxY)

            local anchor = Vector2.new(0, 0)
            if finalY > (mainH * 0.7) then
                anchor = Vector2.new(0, 1)
                finalY = math.min(centerY + (popupH / 2), mainH - margin)
            end

            local finalX = math.clamp(
                hostX,
                margin,
                mainW - popupPanel.Size.X.Offset - (margin * 2) - (popupSearch.AbsoluteSize.X / scale)
            )

            return Vector2.new(finalX, finalY), anchor
        end

        local function applyPopupPosition(rowCount)
            local pos, anchor = positionPopup(rowCount)
            popupPanel.AnchorPoint = anchor
            popupPanel.Position = UDim2.fromOffset(pos.X, pos.Y)
        end

        local searchOpen = false
        local panelOpen = false

        local function closeSearch()
            if not searchOpen then return end
            searchOpen = false
            popupSearchBox.Text = ""
            local t = J(popupSearchBox, "Size", UDim2.new(0, 0, 1, 0), 0.2)
            t:Play()
            t.Completed:Wait()
            popupSearchBox.Visible = false
        end

        local function openSearch()
            if searchOpen then return end
            searchOpen = true
            popupSearchBox.Visible = true
            J(popupSearchBox, "Size", UDim2.new(0, 100, 1, 0), 0.3):Play()
            popupSearchBox:CaptureFocus()

            local panelSize = popupPanel.AbsoluteSize
            local mainSize = I.AbsoluteSize
            local scale = UIScale.Scale
            local searchW = 130 * scale

            local x = popupPanel.AbsolutePosition.X
            local right = x + panelSize.X + 5 + searchW
            if right > mainSize.X - (5 * scale) then
                local shift = (mainSize.X - panelSize.X - searchW - 5 - (5 * scale)) / scale
                shift = math.max(shift, 5)
                J(popupPanel, "Position", UDim2.fromOffset(shift, popupPanel.Position.Y.Offset), 0.3):Play()
            end
        end

        local function setSelected(option, value)
            option.Selected = value
            local inst = option.Instance
            if inst then
                local lbl = inst.TextLabel
                local bar = inst.Frame
                local alpha = value and 0 or (multiSelect and 0.8 or 1)
                local textAlpha = value and 0 or 0.4
                local barSize = UDim2.fromOffset(4, value and 14 or 4)

                if inst.Parent then
                    J(bar, "BackgroundTransparency", alpha, 0.35):Play()
                    J(lbl, "TextTransparency", textAlpha, 0.35):Play()
                    J(bar, "Size", barSize, 0.35):Play()
                else
                    lbl.TextTransparency = textAlpha
                    bar.BackgroundTransparency = alpha
                    bar.Size = barSize
                end
            end
        end

        local function refreshDisplay()
            local text
            if multiSelect then
                local picked = {}
                for name, on in optionEnabled do
                    if on then picked[#picked + 1] = name end
                end
                text = table.concat(picked, ", ")
            else
                text = selected and selected.Name or ""
            end

            if #text >= 100 then
                text = text:sub(1, 97) .. "..."
            end
            displayLbl.Text = #text ~= 0 and text or "..."
        end

        local pendingUpdate = false
        local function scheduleDisplay()
            if pendingUpdate then return end
            pendingUpdate = true
            task.delay(0.05, function()
                pendingUpdate = false
                local value = multiSelect and optionEnabled or (selected and selected.Name)
                G(cb, multiSelect and optionEnabled or value)
                refreshDisplay()
                if flag ~= nil then Flags[flag] = value end
            end)
        end

        local function toggleOption(option)
            if multiSelect then
                local newState = not option.Selected
                setSelected(option, newState)
                optionEnabled[option.Name] = newState
            else
                if selected == option then return nil end
                if selected then setSelected(selected, false) end
                selected = option
                setSelected(option, true)
            end
            scheduleDisplay()
        end

        local function ensureOption(name)
            name = tostring(name)
            if optionsMap[name] then return end

            local entry = { Name = name, DisplayName = name, Selected = false }
            if multiSelect and optionEnabled[name] == nil then
                optionEnabled[name] = false
            end
            optionsMap[name] = entry
            optionsList[#optionsList + 1] = entry
            return entry
        end

        local function buildOptionRow(option, addToScroll)
            local row = E("TextButton", {
                Size = UDim2.new(1, 0, 0, 21),
                AutoButtonColor = false,
                Text = "",
                Elements = { Corner = UDim.new(0, 6) },
                ThemeTag = { BackgroundColor3 = "Colors.Buttons.Default" },
                Childs = {
                    E("Frame", {
                        Position = UDim2.new(0, 1, 0.5),
                        Size = UDim2.new(0, 4, 0, 4),
                        BackgroundTransparency = 1,
                        AnchorPoint = Vector2.new(0, 0.5),
                        Elements = { Corner = UDim.new(0.5, 0) },
                        ThemeTag = { BackgroundColor3 = "Colors.Primary" },
                    }),
                    E("TextLabel", {
                        Size = UDim2.fromScale(1, 1),
                        Position = UDim2.fromOffset(10, 0),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        BackgroundTransparency = 1,
                        TextTransparency = 0.4,
                        Text = option.DisplayName,
                        TextSize = 10,
                        ThemeTag = {
                            Font = "Font.Bold",
                            TextColor3 = "Colors.Text.Default",
                        },
                    }),
                },
            })

            option.SearchText = M(option.DisplayName)
            option.Instance = row
            option.Instance.TextLabel = row:FindFirstChildOfClass("TextLabel")
            option.Instance.Frame = row:FindFirstChildOfClass("Frame")

            local last = 0
            u(row.Activated, function()
                if (tick() - last) < 0 then return end
                if popupRoot.Parent and not panelOpen then
                    last = tick() + 0.2
                    toggleOption(option)
                end
            end)

            if addToScroll then
                row.Parent = popupScroll
                if not popupSearchBox.Visible then
                    setSelected(option, option.Selected)
                end
            end
        end

        local function clearOptions()
            for inst in optionInstances do
                inst.Parent = nil
                optionInstances[inst] = nil
            end
        end

        local function setOptions(newList)
            clearOptions()
            for i = 1, #newList do
                local entry = newList[i]
                if not entry.Instance then
                    buildOptionRow(entry)
                end
                entry.Instance.Parent = popupScroll
                optionInstances[entry.Instance] = true
            end
            applyPopupPosition(#newList)
            J(popupPanel, "Size", UDim2.fromOffset(PANEL_WIDTH, rowCountFor(#newList)), 0.3):Play()
        end

        local function matchesSearch(option, firstChar, query, searchText)
            local passes = true
            local q = query
            if firstChar == "+" or firstChar == "-" then
                passes = option.Selected == (firstChar == "+")
                q = query:sub(2, -1)
            end
            return passes and searchText:find(q, 1, true) ~= nil
        end

        local function applySearch()
            local query = popupSearchBox.Text
            local firstChar = string.sub(query, 1, 1)
            local cleaned = M(query)
            local empty = #cleaned == 0
            local visible = 0
            for i = 1, #optionsList do
                local option = optionsList[i]
                local pass = empty or matchesSearch(option, firstChar, cleaned, option.SearchText)
                option.Instance.Visible = pass
                if pass then visible += 1 end
            end
            applyPopupPosition(visible)
        end

        local function openDropdown(callback)
            if opened == callback then return end
            if not panelOpen then
                popupRoot.Parent = I
            end

            if callback then
                popupRoot.Parent = I
                applyPopupPosition(#optionsList)
                opened = true
                dropdown.Opened = true
                arrowTag.ImageColor3 = "Colors.Primary"
                arrowTag.Image = "Icons.Dropdown.Close"
                J(arrow, "ImageColor3", w(s.CurrentTheme, "Colors.Primary"), 0.35):Play()
                arrow.Image = w(s.CurrentTheme, "Icons.Dropdown.Close")
                J(popupPanel, "Size", UDim2.fromOffset(PANEL_WIDTH, rowCountFor(#optionsList)), 0.3):Play()
            else
                if openedOnce then openedOnce() ; openedOnce = nil end
                task.spawn(closeSearch)
                panelOpen = true
                local t = J(popupPanel, "Size", UDim2.fromOffset(PANEL_WIDTH, 0), 0.2)
                t:Play()
                t.Completed:Wait()
                popupRoot.Parent = nil
                panelOpen = false
                opened = false
                dropdown.Opened = false
                arrowTag.ImageColor3 = "Colors.Icons"
                arrowTag.Image = "Icons.Dropdown.Open"
                J(arrow, "ImageColor3", w(s.CurrentTheme, "Colors.Icons"), 0.35):Play()
                arrow.Image = w(s.CurrentTheme, "Icons.Dropdown.Open")
            end
        end

        u(popupSearch.Activated, openSearch)
        u(popupSearchBox:GetPropertyChangedSignal"Text", applySearch)

        u(box.Activated, function()
            openDropdown(not opened)
        end)

        -- Click outside to close
        u(i.InputBegan, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if opened and not isMouseOverPanel() and not popupSearchBox:IsFocused() then
                openDropdown(false)
            end
        end)

        local function resolveOption(candidate, index)
            if index and type(candidate) == "boolean" then
                return candidate == true and optionsList[index]
            end
            if type(candidate) == "number" then return optionsList[candidate] end
            return optionsMap[tostring(candidate)]
        end

        local function markSelected(option)
            option.Selected = true
            if multiSelect then
                optionEnabled[option.Name] = true
            else
                selected = option
            end
        end

        local function selectDefault(...)
            local opt = resolveOption(...)
            if opt then
                markSelected(opt)
            elseif multiSelect and type(...) == "string" then
                optionEnabled[select(1, ...)] = true
            end
        end

        -- Apply default
        if default then
            for i = 1, (multiSelect and #default or 1) do
                selectDefault(default[i], i)
            end
        end

        local function applyDefaultList()
            if not default then return end
            for i = 1, (multiSelect and #default or 1) do
                selectDefault(default[i], i)
            end
        end

        dropdown.ADD_DROPDOWN_OPTION = function(name)
            if type(name) == "table" then
                for i = 1, #name do
                    dropdown:Add(name[i])
                end
                return nil
            end
            local opt = ensureOption(name)
            if not opt then return end

            if dropdown.Opened then
                buildOptionRow(opt, true)
            end

            local shouldSelect = false
            if multiSelect then
                local n = opt.Name
                shouldSelect = (optionEnabled[n] or (default and table.find(default, n))) == true
            else
                shouldSelect = selected and selected.Name == opt.Name
            end

            if shouldSelect then
                markSelected(opt)
                if opt.Instance then setSelected(opt, opt.Selected) end
            end

            scheduleDisplay()
        end

        dropdown.REMOVE_DROPDOWN_OPTION = function(name)
            local opt = optionsMap[tostring(name)]
            if not opt then return end
            local idx = table.find(optionsList, opt)
            if idx then table.remove(optionsList, idx) end
            if opt.Instance then opt.Instance:Destroy() end
            optionsMap[opt.Name] = nil
        end

        dropdown.CLEAR_DROPDOWN = function()
            for i = #optionsList, 1, -1 do
                local opt = optionsList[i]
                if opt.Instance then opt.Instance:Destroy() end
                optionsMap[opt.Name] = nil
                optionsList[i] = nil
            end
            if dropdown.Opened then clearOptions() end
        end

        -- Populate from list
        if list then
            for i = 1, #list do
                ensureOption(list[i])
            end
        end

        applyDefaultList()
        refreshDisplay()
        if flag ~= nil then
            Flags[flag] = multiSelect and optionEnabled or (selected and selected.Name)
        end

        return dropdown
    end

