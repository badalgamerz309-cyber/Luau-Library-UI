--!nocheck
--[[
    GlassUI v1.0.0
    A GlassMorphism UI Library for Roblox
    Styled after redz-library-v5 (dark gradient, blurple accent, 6-8px corners)

    Features:
      • Draggable, resizable window with minimize/restore
      • Draggable floating restore icon (fully customizable)
      • Tabs, MultiTabs, Sections, Paragraphs
      • Button, Toggle, Checkbox, Slider, Dropdown, TextBox
      • GitHub-style UpperTags
      • Lucide icon support (optional)
      • Animated notifications (bottom -> top)
      • Soft Tween animations everywhere
      • Custom background image/gradient

    Usage:
        local GlassUI = loadstring(game:HttpGet(".../GlassUI.lua"))()
        local Window = GlassUI:CreateWindow({ Title = "My UI", Subtitle = "v1.0" })
]]

local GlassUI = {}
GlassUI.__index = GlassUI

