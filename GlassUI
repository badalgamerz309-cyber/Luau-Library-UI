            })
        end,
        SizeConstraint = function(mode)
            return E("UISizeConstraint", {
                MaxSize = mode or Vector2.new(math.huge, math.huge),
            })
        end,
    }

    function ElementFactory:Create(parent, key, ...)
        local fn = self.ElementsTable[key]
        if fn then
            local inst = fn(...)
            if inst then inst.Parent = parent end
            return inst
        end
        return nil
    end

    -- ========================================================================================
    -- § 5.2 Property handler
    -- ========================================================================================
    local H = {}

    function H:Childs(children)
        for i = 1, #children do
            children[i].Parent = self
        end
    end

    function H:Elements(elements)
        for key, value in pairs(elements) do
            if type(value) == "table" then
                local inst = ElementFactory:Create(self, key)
                if inst then
                    D.SetProperties(inst, value)
                end
            else
                ElementFactory:Create(self, key, value)
            end
        end
    end

    function H:ThemeTag(tag)
        local parent = tag.OBJECTS
        tag.OBJECTS = nil
        return (parent or RootThemeNode):add(self, tag)
    end

    function D:SetProperties(props)
        for key, value in pairs(props) do
            if H[key] then
                H[key](self, value)
            else
                self[key] = value
            end
        end
    end

    function D:SetValues(...)
        local target = self
        for _, value in { ... } do
            local kind = typeof(value)
            if kind == "table" then
                D.SetProperties(target, value)
            else
                target[if kind == "string" then "Name" else "Parent"] = value
            end
        end
        return target
    end

    -- ========================================================================================
    -- § 5.3 Draggable
    -- ========================================================================================
    -- CRITICAL FIX: We never reference `self` for the target — we use the explicit
    -- `target` parameter. This is the fix for the "attempt to index nil with 'Connect'"
    -- crash. The old code accessed `self.InputBegan`, but when called with `D:Draggable(...)`
    -- syntax, `self` was the D table (no InputBegan), not the GUI object.
    -- ========================================================================================
    local DraggingTarget = nil
    local DragWatchdogConn = nil

    function D:Draggable(target, uiscale, lerpFactor, clampFn)
        assert(typeof(target) == "Instance", "Draggable: target must be an Instance")
        assert(target:IsA("GuiObject"), "Draggable: target must be a GuiObject")

        local factor = (type(lerpFactor) == "number" and lerpFactor) or 0.28
        local scaleValue = 1
        if typeof(uiscale) == "Instance" and uiscale:IsA("UIScale") then
            scaleValue = uiscale.Scale
        end

        local dragging = false
        local dragStart = nil
        local startPos = nil
        local releaseConn = nil
        local lastActivity = 0

        local function stopDrag()
            if not dragging then return end
            dragging = false
            if DraggingTarget == target then DraggingTarget = nil end
            IS_DRAGGING_GLOBAL = false
            if releaseConn then
                releaseConn:Disconnect()
                releaseConn = nil
            end
        end

        -- Watchdog: if no movement for 1 second, cancel drag (prevents "stuck" state)
        local function watchdog()
            while dragging do
                if (tick() - lastActivity) >= 1 then
                    stopDrag()
                    break
                end
                task.wait()
            end
        end

        target.InputBegan:Connect(function(input)
            if IS_DRAGGING_GLOBAL or DraggingTarget ~= nil then return end
            local t = input.UserInputType
            if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
                return
            end

            dragging = true
            DraggingTarget = target
            dragStart = input.Position
            startPos = target.Position
            lastActivity = tick()
            IS_DRAGGING_GLOBAL = true

            task.spawn(watchdog)

            releaseConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    stopDrag()
                end
            end)
        end)

        table.insert(Library.Connections, UserInputService.InputChanged:Connect(function(input)
            if not dragging or DraggingTarget ~= target then return end
            local t = input.UserInputType
            if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then
                return
            end
            lastActivity = tick()
            local delta = input.Position - dragStart
            local newX = startPos.X.Offset + delta.X / scaleValue
            local newY = startPos.Y.Offset + delta.Y / scaleValue

            local newPos
            if clampFn then
                newPos = clampFn(startPos.X.Scale, newX, startPos.Y.Scale, newY)
            end
            if newPos == nil then
                newPos = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
            end

            target.Position = target.Position:Lerp(newPos, factor)
        end))
    end

    function D.new(class, ...)
        return D.SetValues(Instance.new(class), ...)
    end

    E = D.new
end

