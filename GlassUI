-- § 6. CALLBACK HELPERS
-- ============================================================================================

-- Normalizes a callback argument. Accepts:
--   • nil           → {}
--   • function      → { function }
--   • { tbl, key }  → { function(v) tbl[key] = v end }
local F = function(cb)
    if cb == nil then return {} end
    if type(cb) ~= "function" and type(cb) ~= "table" then
        error(("Failed to get Callback: 'function' or 'table' expected, got %s"):format(typeof(cb)), 2)
    end
    if type(cb) ~= "function" then
        local tbl, key = cb[1], cb[2]
        cb = function(v) tbl[key] = v end
    end
    return table.pack(cb)
end

-- Runs all callbacks in a packed list, each in its own thread.
local RunCallbacks = function(callbacks, ...)
    for i = 1, #callbacks do
        task.spawn(callbacks[i], ...)
    end
end

